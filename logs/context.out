\n    intro h₃\n    have ⟨_, h₁⟩ := h\n    rw [mod_eq_sub_mod h₁]\n    exact h₂ h₃\n</ITEM>\n<ITEM>\n--name=Nat.sub_add_cancel\n--context_item_type=theorem\n@[simp] protected theorem sub_add_cancel {n m : Nat} (h : m ≤ n) : n - m + m = n := by\n  rw [Nat.add_comm, Nat.add_sub_of_le h]\n</ITEM>\n<ITEM>\n--name=Nat.Prime.eq_one_or_self_of_dvd\n--context_item_type=theorem\ntheorem Prime.eq_one_or_self_of_dvd {p : ℕ} (pp : p.Prime) (m : ℕ) (hm : m ∣ p) :\n    m = 1 ∨ m = p := by\n  obtain ⟨n, hn⟩ := hm\n  have := pp.isUnit_or_isUnit hn\n  rw [Nat.isUnit_iff, Nat.isUnit_iff] at this\n  apply Or.imp_right _ this\n  rintro rfl\n  rw [hn, mul_one]\n</ITEM>\n<ITEM>\n--name=Nat.mod_mod\n--context_item_type=theorem\n@[simp] theorem mod_mod (a n : Nat) : (a % n) % n = a % n :=\n  match eq_zero_or_pos n with\n  | .inl n0 => by simp [n0, mod_zero]\n  | .inr npos => Nat.mod_eq_of_lt (mod_lt _ npos)\n</ITEM>\n<ITEM>\n--name=add_zero\n--context_item_type=theorem\n@[to_additive (attr := simp)]\n</ITEM>\n<ITEM>\n--name=Nat.mul_mod_right\n--context_item_type=theorem\n@[simp] theorem mul_mod_right (m n : Nat) : (m * n) % m = 0 := by\n  rw [← Nat.zero_add (m * n), add_mul_mod_self_left, zero_mod]\n</ITEM>\n<ITEM>\n--name=Nat.add_mod\n--context_item_type=theorem\ntheorem add_mod (a b n : Nat) : (a + b) % n = ((a % n) + (b % n)) % n := by\n  rw [add_mod_mod, mod_add_mod]\n</ITEM>\n<ITEM>\n--name=Nat.le_of_lt\n--context_item_type=theorem\nprotected theorem le_of_lt {n m : Nat} : n < m → n ≤ m := le_of_succ_le\n</ITEM>\n<ITEM>\n--name=Nat.eq_add_of_sub_eq\n--context_item_type=theorem\nprotected theorem eq_add_of_sub_eq {a b c : Nat} (hle : b ≤ a) (h : a - b = c) : a = c + b := by\n  rw [h.symm, Nat.sub_add_cancel hle]\n</ITEM>\n<ITEM>\n--name=add_left_inj\n--context_item_type=theorem\n@[to_additive (attr := simp)]\n</ITEM>\n<ITEM>\n--name=add_assoc\n--context_item_type=theorem\n@[to_additive]\n</ITEM>\n<ITEM>\n--name=Nat.two_mul\n--context_item_type=theorem\nprotected theorem two_mul (n) : 2