>\n--name=Real.mul_rpow\n--context_item_type=theorem\ntheorem mul_rpow (hx : 0 ≤ x) (hy : 0 ≤ y) : (x * y) ^ z = x ^ z * y ^ z := by\n  iterate 2 rw [Real.rpow_def_of_nonneg]; split_ifs with h_ifs <;> simp_all\n  · rw [log_mul ‹_› ‹_›, add_mul, exp_add, rpow_def_of_pos (hy.lt_of_ne' ‹_›)]\n  all_goals positivity\n</ITEM>\n<ITEM>\n--name=Real.rpow_add_natCast\n--context_item_type=theorem\nlemma rpow_add_natCast {x : ℝ} (hx : x ≠ 0) (y : ℝ) (n : ℕ) : x ^ (y + n) = x ^ y * x ^ n := by\n  simpa using rpow_add_intCast hx y n\n</ITEM>\n<ITEM>\n--name=mul_comm\n--context_item_type=theorem\n@[to_additive]\ntheorem mul_comm : ∀ a b : G, a * b = b * a := CommMagma.mul_comm\n</ITEM>\n<ITEM>\n--name=Real.rpow_mul\n--context_item_type=theorem\ntheorem rpow_mul {x : ℝ} (hx : 0 ≤ x) (y z : ℝ) : x ^ (y * z) = (x ^ y) ^ z := by\n  rw [← Complex.ofReal_inj, Complex.ofReal_cpow (rpow_nonneg hx _),\n      Complex.ofReal_cpow hx, Complex.ofReal_mul, Complex.cpow_mul, Complex.ofReal_cpow hx] <;>\n    simp only [(Complex.ofReal_mul _ _).symm, (Complex.ofReal_log hx).symm, Complex.ofReal_im,\n      neg_lt_zero, pi_pos, le_of_lt pi_pos]\n</ITEM>\n<ITEM>\n--name=Real.rpow_two\n--context_item_type=theorem\n@[simp]\ntheorem rpow_two (x : ℝ) : x ^ (2 : ℝ) = x ^ 2 := by\n  rw [← rpow_natCast]\n  simp only [Nat.cast_ofNat]\n</ITEM>\n<ITEM>\n--name=mul_le_mul_left\n--context_item_type=theorem\n@[simp]\ntheorem mul_le_mul_left [PosMulMono α] [PosMulReflectLE α] (a0 : 0 < a) : a * b ≤ a * c ↔ b ≤ c :=\n  @rel_iff_cov α>0 α (fun x y => x * y) (· ≤ ·) _ _ ⟨a, a0⟩ _ _\n</ITEM>\n<ITEM>\n--name=le_of_add_le_add_right\n--context_item_type=theorem\n@[to_additive le_of_add_le_add_right]\n</ITEM>\n<ITEM>\n--name=min_eq_left\n--context_item_type=theorem\nlemma min_eq_left (h : a ≤ b) : min a b = a := by\n  apply Eq.symm; apply eq_min (le_refl _) h; intros; assumption\n</ITEM>\n<ITEM>\n--name=mul_self_le_mul_self\n--context_item_type=theorem\ntheorem mul_self_le_mul_self [PosMulMono α] [MulPosMono α] (ha : 0 ≤