\n    intro h₃\n    have ⟨_, h₁⟩ := h\n    rw [mod_eq_sub_mod h₁]\n    exact h₂ h₃\n</ITEM>\n<ITEM>\n--name=Nat.sub_add_cancel\n--context_item_type=theorem\n@[simp] protected theorem sub_add_cancel {n m : Nat} (h : m ≤ n) : n - m + m = n := by\n  rw [Nat.add_comm, Nat.add_sub_of_le h]\n</ITEM>\n<ITEM>\n--name=Nat.Prime.eq_one_or_self_of_dvd\n--context_item_type=theorem\ntheorem Prime.eq_one_or_self_of_dvd {p : ℕ} (pp : p.Prime) (m : ℕ) (hm : m ∣ p) :\n    m = 1 ∨ m = p := by\n  obtain ⟨n, hn⟩ := hm\n  have := pp.isUnit_or_isUnit hn\n  rw [Nat.isUnit_iff, Nat.isUnit_iff] at this\n  apply Or.imp_right _ this\n  rintro rfl\n  rw [hn, mul_one]\n</ITEM>\n<ITEM>\n--name=Nat.mod_mod\n--context_item_type=theorem\n@[simp] theorem mod_mod (a n : Nat) : (a % n) % n = a % n :=\n  match eq_zero_or_pos n with\n  | .inl n0 => by simp [n0, mod_zero]\n  | .inr npos => Nat.mod_eq_of_lt (mod_lt _ npos)\n</ITEM>\n<ITEM>\n--name=add_zero\n--context_item_type=theorem\n@[to_additive (attr := simp)]\n</ITEM>\n<ITEM>\n--name=Nat.mul_mod_right\n--context_item_type=theorem\n@[simp] theorem mul_mod_right (m n : Nat) : (m * n) % m = 0 := by\n  rw [← Nat.zero_add (m * n), add_mul_mod_self_left, zero_mod]\n</ITEM>\n<ITEM>\n--name=Nat.add_mod\n--context_item_type=theorem\ntheorem add_mod (a b n : Nat) : (a + b) % n = ((a % n) + (b % n)) % n := by\n  rw [add_mod_mod, mod_add_mod]\n</ITEM>\n<ITEM>\n--name=Nat.le_of_lt\n--context_item_type=theorem\nprotected theorem le_of_lt {n m : Nat} : n < m → n ≤ m := le_of_succ_le\n</ITEM>\n<ITEM>\n--name=Nat.eq_add_of_sub_eq\n--context_item_type=theorem\nprotected theorem eq_add_of_sub_eq {a b c : Nat} (hle : b ≤ a) (h : a - b = c) : a = c + b := by\n  rw [h.symm, Nat.sub_add_cancel hle]\n</ITEM>\n<ITEM>\n--name=add_left_inj\n--context_item_type=theorem\n@[to_additive (attr := simp)]\n</ITEM>\n<ITEM>\n--name=add_assoc\n--context_item_type=theorem\n@[to_additive]\n</ITEM>\n<ITEM>\n--name=Nat.two_mul\n--context_item_type=theorem\nprotected theorem two_mul (n) : 2 * n = n + n := by rw [Nat.succ_mul, Nat.one_mul]\n</ITEM>\n<ITEM>\n--name=Nat.eq_of_mul_eq_mul_left\n--context_item_type=theorem\nprotected theorem eq_of_mul_eq_mul_left {m k n : Nat} (hn : 0 < n) (h : n * m = n * k) : m = k :=\n  Nat.le_antisymm (Nat.le_of_mul_le_mul_left (Nat.le_of_eq h) hn)\n                  (Nat.le_of_mul_le_mul_left (Nat.le_of_eq h.symm) hn)\n</ITEM>\n<ITEM>\n--name=Nat.Prime.dvd_mul\n--context_item_type=theorem\ntheorem Prime.dvd_mul {p m n : ℕ} (pp : Prime p) : p ∣ m * n ↔ p ∣ m ∨ p ∣ n :=\n  ⟨fun H => or_iff_not_imp_left.2 fun h => (pp.coprime_iff_not_dvd.2 h).dvd_of_dvd_mul_left H,\n    Or.rec (fun h : p ∣ m => h.mul_right _) fun h : p ∣ n => h.mul_left _⟩\n</ITEM>\n<ITEM>\n--name=Or.resolve_left\n--context_item_type=theorem\ntheorem Or.resolve_left  (h: Or a b) (na : Not a) : b := h.elim (absurd · na) id\n</ITEM>\n<ITEM>\n--name=mul_comm\n--context_item_type=theorem\n@[to_additive]\ntheorem mul_comm : ∀ a b : G, a * b = b * a := CommMagma.mul_comm\n</ITEM>\n<ITEM>\n--name=Nat.dvd_mul_right\n--context_item_type=theorem\nprotected theorem dvd_mul_right (a b : Nat) : a ∣ a * b := ⟨b, rfl⟩\n</ITEM>\n<ITEM>\n--name=Nat.not_dvd_of_pos_of_lt\n--context_item_type=theorem\nlemma not_dvd_of_pos_of_lt (h1 : 0 < n) (h2 : n < m) : ¬m ∣ n := by\n  rintro ⟨k, rfl⟩\n  rcases Nat.eq_zero_or_pos k with (rfl | hk)\n  · exact Nat.lt_irrefl 0 h1\n  · exact Nat.not_lt.2 (Nat.le_mul_of_pos_right _ hk) h2\n</ITEM>\n<ITEM>\n--name=tsub_lt_of_lt\n--context_item_type=theorem\ntheorem tsub_lt_of_lt (h : a < b) : a - c < b :=\n  lt_of_le_of_lt tsub_le_self h\n</ITEM>\n<ITEM>\n--name=Nat.sub_pos_of_lt\n--context_item_type=theorem\nprotected theorem sub_pos_of_lt (h : m < n) : 0 < n - m :=\n  Nat.pos_iff_ne_zero.2 (Nat.sub_ne_zero_of_lt h)\n</ITEM>\n<ITEM>\n--name=lt_of_pow_lt_pow_left'\n--context_item_type=theorem\n@[to_additive lt_of_nsmul_lt_nsmul_right]\ntheorem lt_of_pow_lt_pow_left' {a b : M} (n : ℕ) : a ^ n < b ^ n → a < b :=\n  (pow_left_mono _).reflect_lt\n</ITEM>\n<ITEM>\n--name=Nat.Prime.one_lt\n--context_item_type=theorem\ntheorem Prime.one_lt {p : ℕ} : Prime p → 1 < p :=\n  Prime.two_le\n</ITEM>\n<ITEM>\n--name=lt_mul_right\n--context_item_type=theorem\nlemma lt_mul_right [PosMulStrictMono M₀] (ha : 0 < a) (hb : 1 < b) : a < a * b := by\n  simpa using mul_lt_mul_of_pos_left hb ha\n</ITEM>\n<ITEM>\n--name=Nat.add_sub_add_right\n--context_item_type=theorem\nprotected theorem add_sub_add_right (n k m : Nat) : (n + k) - (m + k) = n - m := by\n  induction k with\n  | zero => simp\n  | succ k ih => simp [← Nat.add_assoc, succ_sub_succ_eq_sub, ih]\n</ITEM>\n<ITEM>\n--name=Mathlib.Tactic.LinearCombination'.sub_pf\n--context_item_type=theorem\ntheorem sub_pf [Sub α] (p₁ : (a₁:α) = b₁) (p₂ : a₂ = b₂) : a₁ - a₂ = b₁ - b₂ := p₁ ▸ p₂ ▸ rfl\n</ITEM>\n<ITEM>\n--name=mul_one\n--context_item_type=theorem\n@[to_additive (attr := simp)]\ntheorem mul_one : ∀ a : M, a * 1 = a :=\n  MulOneClass.mul_one\n</ITEM>\n<ITEM>\n--name=Nat.mul_sub_left_distrib\n--context_item_type=theorem\nprotected theorem mul_sub_left_distrib (n m k : Nat) : n * (m - k) = n * m - n * k := by\n  rw [Nat.mul_comm, Nat.mul_sub_right_distrib, Nat.mul_comm m n, Nat.mul_comm n k]\n</ITEM>\n<ITEM>\n--name=Nat.sq_sub_sq\n--context_item_type=theorem\nlemma sq_sub_sq (a b : ℕ) : a ^ 2 - b ^ 2 = (a + b) * (a - b) := by\n  simpa [Nat.pow_succ] using Nat.mul_self_sub_mul_self_eq a b\n</ITEM>\n<ITEM>\n--name=Nat.le_lt_asymm\n--context_item_type=theorem\nprotected theorem le_lt_asymm : ∀{a b : Nat}, a ≤ b → ¬(b < a) := flip Nat.not_le_of_gt\n</ITEM>\n<ITEM>\n--name=mul_lt_mul_left\n--context_item_type=theorem\n@[simp]\ntheorem mul_lt_mul_left [PosMulStrictMono α] [PosMulReflectLT α] (a0 : 0 < a) :\n    a * b < a * c ↔ b < c :=\n  @rel_iff_cov α>0 α (fun x y => x * y) (· < ·) _ _ ⟨a, a0⟩ _ _\n</ITEM>\n<ITEM>\n--name=Nat.add_le_add_right\n--context_item_type=theorem\nprotected theorem add_le_add_right {n m : Nat} (h : n ≤ m) (k : Nat) : n + k ≤ m + k := by\n  rw [Nat.add_comm n