he theorem is `a = a`, Lean will allow anything that is\ndefinitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in\nLean by `rfl`, because both sides are the same up to definitional equality.\n-/\n@[match_pattern] def rfl {α : Sort u} {a : α} : Eq a a := Eq.refl a\n</ITEM>\n<ITEM>\n--name=Subtype.coe_mk\n--context_item_type=theorem\ntheorem coe_mk (a h) : (@mk α p a h : α) = a :=\n  rfl\n</ITEM>\n<ITEM>\n--name=div_pos\n--context_item_type=theorem\nlemma div_pos [PosMulStrictMono G₀] (ha : 0 < a) (hb : 0 < b) : 0 < a / b := by\n  rw [div_eq_mul_inv]; exact mul_pos ha (inv_pos.2 hb)\n</ITEM>\n<ITEM>\n--name=lt_add_of_pos_of_le\n--context_item_type=theorem\n@[to_additive]\n</ITEM>\n<ITEM>\n--name=trans\n--context_item_type=theorem\nlemma trans [IsTrans α r] : a ≺ b → b ≺ c → a ≺ c := IsTrans.trans _ _ _\n</ITEM>\n<ITEM>\n--name=one_lt_two\n--context_item_type=theorem\nlemma one_lt_two [AddLeftStrictMono α] : (1 : α) < 2 := by\n  rw [← one_add_one_eq_two]\n  exact lt_add_one _\n</ITEM>\n<ITEM>\n--name=Subtype.mk_lt_mk\n--context_item_type=theorem\n@[simp]\ntheorem mk_lt_mk [LT α] {p : α → Prop} {x y : α} {hx : p x} {hy : p y} :\n    (⟨x, hx⟩ : Subtype p) < ⟨y, hy⟩ ↔ x < y :=\n  Iff.rfl\n</ITEM>\n<ITEM>\n--name=sub_add_cancel\n--context_item_type=theorem\n@[to_additive (attr := simp)]\n</ITEM>\n<ITEM>\n--name=sub_pos\n--context_item_type=theorem\n@[to_additive (attr := simp) sub_pos]\n</ITEM>\n<ITEM>\n--name=Iff.mpr\n--context_item_type=theorem\n  mpr : b → a\n</ITEM>\n<ITEM>\n--name=div_div_eq_mul_div\n--context_item_type=theorem\n@[to_additive, field_simps] -- The attributes are out of order on purpose\ntheorem div_div_eq_mul_div : a / (b / c) = a * c / b := by simp\n</ITEM>\n<ITEM>\n--name=div_div_cancel\n--context_item_type=theorem\n@[to_additive (attr := simp)]\ntheorem div_div_cancel (a b : G) : a / (a / b) = b :=\n  div_div_self' a b\n</ITEM>\n<ITEM>\n--name=mul_div_cancel_left\n--context_item_type=theorem\n@[to_additive (attr := simp)]\ntheor