/-- Turn a `SignType` into zero, one, or minus one. This is a coercion instance, but note it is
only a `CoeTC` instance: see note [use has_coe_t]. -/
@[coe]
def cast : SignType → α
  | zero => 0
  | pos => 1
  | neg => -1

-- Porting note: Translated has_coe_t to CoeTC

instance : CoeTC SignType α :=
  ⟨cast⟩

