    ⊢ Eq (SignType.sign (s.sum fun i => f i)) t
  -/
  cases t
    /-
      case zero
      α : Type u_1
      inst✝ : LinearOrderedAddCommGroup α
      ι : Type u_2
      s : Finset ι
