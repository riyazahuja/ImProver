instance : Zero SignType :=
  ⟨zero⟩


instance : One SignType :=
  ⟨pos⟩


instance : Neg SignType :=
  ⟨fun s =>
    match s with
    | neg => pos
    | zero => zero
    | pos => neg⟩


@[simp]
theorem zero_eq_zero : zero = 0 :=
  rfl


@[simp]
theorem neg_eq_neg_one : neg = -1 :=
  rfl


@[simp]
theorem pos_eq_one : pos = 1 :=
  rfl


instance : Mul SignType :=
  ⟨fun x y =>
    match x with
    | neg => -y
    | zero => zero
    | pos => y⟩


