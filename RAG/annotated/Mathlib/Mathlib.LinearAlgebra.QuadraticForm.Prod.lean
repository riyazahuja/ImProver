    ι : Type u_1
    R : Type u_2
    P : Type u_7
    Mᵢ : ι → Type u_8
    inst✝⁶ : CommSemiring R
    inst✝⁵ : (i : ι) → AddCommMonoid (Mᵢ i)
    inst✝⁴ : AddCommMonoid P
    inst✝³ : (i : ι) → Module R (Mᵢ i)
    inst✝² : Module R P
    inst✝¹ : Fintype ι
    inst✝ : DecidableEq ι
    Q : (i : ι) → QuadraticMap R (Mᵢ i) P
    i : ι
    m : Mᵢ i
    ⊢ Eq ((QuadraticMap.pi Q) (Pi.single i m)) ((Q i) m)
  -/
  rw [pi_apply, Fintype.sum_eq_single i fun j hj => ?_, Pi.single_eq_same]
