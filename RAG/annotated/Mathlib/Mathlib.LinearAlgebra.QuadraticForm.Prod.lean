    (i : ι) (Q : QuadraticMap R (Mᵢ i) P) :
    (proj i Q).comp (single _ i) = .ofEq (Pi.single_eq_same _ _) :=
  ext fun _ => Pi.single_eq_same _ _


/-- Note that `0 : 0 →qᵢ Q` alone would not be well-typed as the RHS. -/
