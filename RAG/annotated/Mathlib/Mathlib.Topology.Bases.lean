    t : TopologicalSpace α
    ι : Sort u_2
    inst✝ : Countable ι
    s c : ι → Set α
    hc : ∀ (i : ι), (c i).Countable
    h'c : ∀ (i : ι), HasSubset.Subset (s i) (closure (c i))
    ⊢ TopologicalSpace.IsSeparable (Set.iUnion fun i => s i)
  -/
  refine ⟨⋃ i, c i, countable_iUnion hc, iUnion_subset_iff.2 fun i => ?_⟩
  /-
    α : Type u
    t : TopologicalSpace α
    ι : Sort u_2
    inst✝ : Countable ι
    s c : ι → Set α
    hc : ∀ (i : ι), (c i).Countable
    h'c : ∀ (i : ι), HasSubset.Subset (s i) (closure (c i))
    i : ι
    ⊢ HasSubset.Subset (s i) (closure (Set.iUnion fun i => c i))
  -/
  exact (h'c i).trans (closure_mono (subset_iUnion _ i))
  /-
    🎉 no goals
  -/


