/-- In a separable space, a family of nonempty disjoint open sets is countable. -/
theorem _root_.Pairwise.countable_of_isOpen_disjoint [SeparableSpace α] {ι : Type*}
    {s : ι → Set α} (hd : Pairwise (Disjoint on s)) (ho : ∀ i, IsOpen (s i))
    (hne : ∀ i, (s i).Nonempty) : Countable ι := by
  /-
    α : Type u
    t : TopologicalSpace α
    inst✝ : TopologicalSpace.SeparableSpace α
    ι : Type u_2
    s : ι → Set α
    hd : Pairwise (Function.onFun Disjoint s)
    ho : ∀ (i : ι), IsOpen (s i)
    hne : ∀ (i : ι), (s i).Nonempty
    ⊢ Countable ι
  -/
  rcases exists_countable_dense α with ⟨u, u_countable, u_dense⟩
  /-
    case intro.intro
    α : Type u
    t : TopologicalSpace α
    inst✝ : TopologicalSpace.SeparableSpace α
    ι : Type u_2
    s : ι → Set α
    hd : Pairwise (Function.onFun Disjoint s)
    ho : ∀ (i : ι), IsOpen (s i)
    hne : ∀ (i : ι), (s i).Nonempty
    u : Set α
    u_countable : u.Countable
    u_dense : Dense u
    ⊢ Countable ι
  -/
  choose f hfu hfs using fun i ↦ u_dense.exists_mem_open (ho i) (hne i)
  have f_inj : Injective f := fun i j hij ↦
    hd.eq <| not_disjoint_iff.2 ⟨f i, hfs i, hij.symm ▸ hfs j⟩
  /-
    case intro.intro
    α : Type u
    t : TopologicalSpace α
    inst✝ : TopologicalSpace.SeparableSpace α
    ι : Type u_2
    s : ι → Set α
    hd : Pairwise (Function.onFun Disjoint s)
    ho : ∀ (i : ι), IsOpen (s i)
    hne : ∀ (i : ι), (s i).Nonempty
    u : Set α
    u_countable : u.Countable
    u_dense : Dense u
    f : ι → α
    hfu : ∀ (i : ι), Membership.mem u (f i)
    hfs : ∀ (i : ι), Membership.mem (s i) (f i)
    f_inj : Function.Injective f
    ⊢ Countable ι
  -/
  have := u_countable.to_subtype
  /-
    case intro.intro
    α : Type u
    t : TopologicalSpace α
    inst✝ : TopologicalSpace.SeparableSpace α
    ι : Type u_2
    s : ι → Set α
    hd : Pairwise (Function.onFun Disjoint s)
    ho : ∀ (i : ι), IsOpen (s i)
    hne : ∀ (i : ι), (s i).Nonempty
    u : Set α
    u_countable : u.Countable
    u_dense : Dense u
    f : ι → α
    hfu : ∀ (i : ι), Membership.mem u (f i)
    hfs : ∀ (i : ι), Membership.mem (s i) (f i)
    f_inj : Function.Injective f
    this : Countable ↑u
    ⊢ Countable ι
  -/
  exact (f_inj.codRestrict hfu).countable
  /-
    🎉 no goals
  -/


