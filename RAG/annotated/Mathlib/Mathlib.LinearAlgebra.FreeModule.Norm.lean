    inst✝⁶ : CommRing S
    inst✝⁵ : IsDomain S
    F : Type u_4
    inst✝⁴ : Field F
    inst✝³ : Algebra (Polynomial F) S
    inst✝² : Finite ι
    inst✝¹ : Algebra F S
    inst✝ : IsScalarTower F (Polynomial F) S
    b : Basis ι (Polynomial F) S
    f : S
    hf : Ne f 0
    ⊢ Eq (Module.finrank F (HasQuotient.Quotient S (Ideal.span (Singleton.singleto …
  -/
  haveI := Fintype.ofFinite ι
  /-
    S : Type u_2
    ι : Type u_3
    inst✝⁶ : CommRing S
    inst✝⁵ : IsDomain S
    F : Type u_4
    inst✝⁴ : Field F
    inst✝³ : Algebra (Polynomial F) S
    inst✝² : Finite ι
    inst✝¹ : Algebra F S
    inst✝ : IsScalarTower F (Polynomial F) S
    b : Basis ι (Polynomial F) S
    f : S
    hf : Ne f 0
    this : Fintype ι
    ⊢ Eq (Module.finrank F (HasQuotient.Quotient S (Ideal.span (Singleton.singleto …
  -/
  have h := span_singleton_eq_bot.not.2 hf
  rw [natDegree_eq_of_degree_eq
      (degree_eq_degree_of_associated <| associated_norm_prod_smith b hf)]
  /-
    S : Type u_2
    ι : Type u_3
    inst✝⁶ : CommRing S
    inst✝⁵ : IsDomain S
    F : Type u_4
    inst✝⁴ : Field F
    inst✝³ : Algebra (Polynomial F) S
    inst✝² : Finite ι
    inst✝¹ : Algebra F S
    inst✝ : IsScalarTower F (Polynomial F) S
    b : Basis ι (Polynomial F) S
    f : S
    hf : Ne f 0
    this : Fintype ι
    h : Not (Eq (Ideal.span (Singleton.singleton f)) Bot.bot)
    ⊢ Eq (Module.finrank F (HasQuotient.Quotient S (Ideal.span (Singleton.singleto …
  -/
  rw [natDegree_prod _ _ fun i _ => smithCoeffs_ne_zero b _ h i, finrank_quotient_eq_sum F h b]
  -- finrank_quotient_eq_sum slow
  /-
    S : Type u_2
    ι : Type u_3
    inst✝⁶ : CommRing S
    inst✝⁵ : IsDomain S
    F : Type u_4
    inst✝⁴ : Field F
    inst✝³ : Algebra (Polynomial F) S
    inst✝² : Finite ι
    inst✝¹ : Algebra F S
    inst✝ : IsScalarTower F (Polynomial F) S
    b : Basis ι (Polynomial F) S
    f : S
    hf : Ne f 0
    this : Fintype ι
    h : Not (Eq (Ideal.span (Singleton.singleton f)) Bot.bot)
    ⊢ Eq (Finset.univ.sum fun i => Module.finrank F (HasQuotient.Quotient (Polynom …
  -/
  congr with i
  /-
    case e_f.h
    S : Type u_2
    ι : Type u_3
    inst✝⁶ : CommRing S
    inst✝⁵ : IsDomain S
    F : Type u_4
    inst✝⁴ : Field F
    inst✝³ : Algebra (Polynomial F) S
    inst✝² : Finite ι
    inst✝¹ : Algebra F S
    inst✝ : IsScalarTower F (Polynomial F) S
    b : Basis ι (Polynomial F) S
    f : S
    hf : Ne f 0
    this : Fintype ι
    h : Not (Eq (Ideal.span (Singleton.singleton f)) Bot.bot)
    i : ι
    ⊢ Eq (Module.finrank F (HasQuotient.Quotient (Polynomial F) (Ideal.span (Singl …
  -/
  exact (AdjoinRoot.powerBasis <| smithCoeffs_ne_zero b _ h i).finrank
  /-
    🎉 no goals
  -/


