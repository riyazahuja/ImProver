  -/
  obtain ⟨ι, ⟨hι₁, hι₂⟩⟩ := fp
  /-
    case mk.intro.intro
    R M : Type u
    inst✝² : Ring R
    inst✝¹ : AddCommGroup M
    inst✝ : Module R M
    ι : Finset M
    hι₁ : Eq (Submodule.span R ↑ι) Top.top
    hι₂ : (LinearMap.ker (Finsupp.linearCombination R Subtype.val)).FG
    ⊢ Exists fun L => Exists fun x => Exists fun x_1 => Exists fun K => Exists fun …
  -/
  use ι →₀ R, inferInstance, inferInstance
  /-
    case h
    R M : Type u
    inst✝² : Ring R
    inst✝¹ : AddCommGroup M
    inst✝ : Module R M
    ι : Finset M
    hι₁ : Eq (Submodule.span R ↑ι) Top.top
    hι₂ : (LinearMap.ker (Finsupp.linearCombination R Subtype.val)).FG
    ⊢ Exists fun K => Exists fun x => And (Module.Free R (Finsupp (Subtype fun x = …
  -/
  use LinearMap.ker (Finsupp.linearCombination R Subtype.val)
  /-
    case h
    R M : Type u
    inst✝² : Ring R
    inst✝¹ : AddCommGroup M
    inst✝ : Module R M
    ι : Finset M
    hι₁ : Eq (Submodule.span R ↑ι) Top.top
    hι₂ : (LinearMap.ker (Finsupp.linearCombination R Subtype.val)).FG
    ⊢ Exists fun x => And (Module.Free R (Finsupp (Subtype fun x => Membership.mem …
  -/
  refine ⟨(LinearMap.quotKerEquivOfSurjective _ ?_).symm, inferInstance, inferInstance, hι₂⟩
  /-
    case h
    R M : Type u
    inst✝² : Ring R
    inst✝¹ : AddCommGroup M
    inst✝ : Module R M
    ι : Finset M
    hι₁ : Eq (Submodule.span R ↑ι) Top.top
    hι₂ : (LinearMap.ker (Finsupp.linearCombination R Subtype.val)).FG
    ⊢ Function.Surjective ⇑(Finsupp.linearCombination R Subtype.val)
  -/
  apply LinearMap.range_eq_top.mp
  /-
    case h
    R M : Type u
    inst✝² : Ring R
    inst✝¹ : AddCommGroup M
    inst✝ : Module R M
    ι : Finset M
    hι₁ : Eq (Submodule.span R ↑ι) Top.top
    hι₂ : (LinearMap.ker (Finsupp.linearCombination R Subtype.val)).FG
    ⊢ Eq (LinearMap.range (Finsupp.linearCombination R Subtype.val)) Top.top
  -/
  simpa only [Finsupp.range_linearCombination, Subtype.range_coe_subtype, Finset.setOf_mem]
  /-
    🎉 no goals
  -/

