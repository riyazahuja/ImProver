    /-
      R✝ : Type u
      F : Type u_1
      R : Type u_2
      S : Type u_3
      inst✝⁹ : NonUnitalSemiring R
      inst✝⁸ : PartialOrder R
      inst✝⁷ : StarRing R
      inst✝⁶ : StarOrderedRing R
      inst✝⁵ : NonUnitalSemiring S
      inst✝⁴ : PartialOrder S
      inst✝³ : StarRing S
      inst✝² : StarOrderedRing S
      inst✝¹ : EquivLike F R S
      inst✝ : StarRingEquivClass F R S
      f : F
      x y : R
      h : LE.le (f x) (f y)
      f_inv : NonUnitalStarRingHom S R := ↑(↑f).symm
      f_inv_f : ∀ (r : R), Eq (f_inv (f r)) r
      ⊢ LE.le x y
    -/
    rw [← f_inv_f x, ← f_inv_f y]
    /-
      R✝ : Type u
      F : Type u_1
      R : Type u_2
      S : Type u_3
      inst✝⁹ : NonUnitalSemiring R
      inst✝⁸ : PartialOrder R
      inst✝⁷ : StarRing R
      inst✝⁶ : StarOrderedRing R
      inst✝⁵ : NonUnitalSemiring S
      inst✝⁴ : PartialOrder S
      inst✝³ : StarRing S
      inst✝² : StarOrderedRing S
      inst✝¹ : EquivLike F R S
      inst✝ : StarRingEquivClass F R S
      f : F
