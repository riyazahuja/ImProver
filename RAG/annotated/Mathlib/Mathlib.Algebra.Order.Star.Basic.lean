@[aesop 10% apply]
lemma IsSelfAdjoint.of_nonneg {x : R} (hx : 0 ≤ x) : IsSelfAdjoint x :=
  .mono hx <| .zero R


/-- An alias of `IsSelfAdjoint.of_nonneg` for use with dot notation. -/
