    [StarRing S] [StarOrderedRing S] [NonUnitalRingHomClass F R S]
    [NonUnitalStarRingHomClass F R S] : OrderHomClass F R S where
  map_rel f := (f : R →⋆ₙ+* S).map_le_map_of_map_star


instance (priority := 100) StarRingEquivClass.instOrderIsoClass [EquivLike F R S]
    [StarRingEquivClass F R S] : OrderIsoClass F R S where
  map_le_map_iff f x y := by
    /-
      R✝ : Type u
      F : Type u_1
      R : Type u_2
      S : Type u_3
      inst✝⁹ : NonUnitalSemiring R
      inst✝⁸ : PartialOrder R
      inst✝⁷ : StarRing R
      inst✝⁶ : StarOrderedRing R
      inst✝⁵ : NonUnitalSemiring S
      inst✝⁴ : PartialOrder S
      inst✝³ : StarRing S
      inst✝² : StarOrderedRing S
      inst✝¹ : EquivLike F R S
      inst✝ : StarRingEquivClass F R S
      f : F
      x y : R
      ⊢ Iff (LE.le (f x) (f y)) (LE.le x y)
    -/
    refine ⟨fun h ↦ ?_, map_rel f⟩
    /-
      R✝ : Type u
      F : Type u_1
      R : Type u_2
      S : Type u_3
      inst✝⁹ : NonUnitalSemiring R
      inst✝⁸ : PartialOrder R
      inst✝⁷ : StarRing R
      inst✝⁶ : StarOrderedRing R
      inst✝⁵ : NonUnitalSemiring S
      inst✝⁴ : PartialOrder S
      inst✝³ : StarRing S
      inst✝² : StarOrderedRing S
      inst✝¹ : EquivLike F R S
      inst✝ : StarRingEquivClass F R S
      f : F
      x y : R
      h : LE.le (f x) (f y)
      ⊢ LE.le x y
    -/
    let f_inv : S →⋆ₙ+* R := (f : R ≃⋆+* S).symm
    /-
      R✝ : Type u
      F : Type u_1
      R : Type u_2
      S : Type u_3
      inst✝⁹ : NonUnitalSemiring R
      inst✝⁸ : PartialOrder R
      inst✝⁷ : StarRing R
      inst✝⁶ : StarOrderedRing R
      inst✝⁵ : NonUnitalSemiring S
      inst✝⁴ : PartialOrder S
      inst✝³ : StarRing S
      inst✝² : StarOrderedRing S
      inst✝¹ : EquivLike F R S
      inst✝ : StarRingEquivClass F R S
      f : F
      x y : R
      h : LE.le (f x) (f y)
      f_inv : NonUnitalStarRingHom S R := ↑(↑f).symm
      ⊢ LE.le x y
    -/
