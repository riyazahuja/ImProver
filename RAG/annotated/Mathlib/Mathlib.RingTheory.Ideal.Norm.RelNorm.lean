            inst✝ : Algebra R S
            r : S
            x : R
            hx : Membership.mem (Set.image ⇑(Algebra.norm R) ↑(Ideal.span (Singleton.singl …
            ⊢ Dvd.dvd ((Algebra.norm R) r) x
          -/
          obtain ⟨x, hx', rfl⟩ := (Set.mem_image _ _ _).mp hx
          /-
            case intro.intro
            R : Type u_1
            inst✝² : CommRing R
            S : Type u_2
            inst✝¹ : CommRing S
            inst✝ : Algebra R S
