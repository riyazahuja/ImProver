theorem spanNorm_bot [Nontrivial S] [Module.Free R S] [Module.Finite R S] :
                                                                   /-
                                                                     R : Type u_1
                                                                     inst✝⁵ : CommRing R
                                                                     S : Type u_2
                                                                     inst✝⁴ : CommRing S
                                                                     inst✝³ : Algebra R S
                                                                     inst✝² : Nontrivial S
                                                                     inst✝¹ : Module.Free R S
                                                                     inst✝ : Module.Finite R S
                                                                     x : R
                                                                     hx : Membership.mem (Set.image ⇑(Algebra.norm R) ↑Bot.bot) x
                                                                     ⊢ Eq x 0
                                                                   -/
    spanNorm R (⊥ : Ideal S) = ⊥ := span_eq_bot.mpr fun x hx => by simpa using hx
