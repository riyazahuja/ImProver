/-- A finitely generated idempotent ideal is generated by an idempotent element -/
theorem isIdempotentElem_iff_of_fg {R : Type*} [CommRing R] (I : Ideal R) (h : I.FG) :
    IsIdempotentElem I ↔ ∃ e : R, IsIdempotentElem e ∧ I = R ∙ e := by
  /-
    R : Type u_1
    inst✝ : CommRing R
    I : Ideal R
    h : I.FG
    ⊢ Iff (IsIdempotentElem I) (Exists fun e => And (IsIdempotentElem e) (Eq I (Su …
  -/
  constructor
    /-
      case mp
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      ⊢ IsIdempotentElem I → Exists fun e => And (IsIdempotentElem e) (Eq I (Submodu …
    -/
  · intro e
    obtain ⟨r, hr, hr'⟩ :=
      Submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul I I h
        (by
          rw [smul_eq_mul]
          exact e.ge)
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      e : IsIdempotentElem I
      r : R
      hr : Membership.mem I r
      hr' : ∀ (n : R), Membership.mem I n → Eq (HSMul.hSMul r n) n
      ⊢ Exists fun e => And (IsIdempotentElem e) (Eq I (Submodule.span R (Singleton. …
    -/
    simp_rw [smul_eq_mul] at hr'
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      e : IsIdempotentElem I
      r : R
      hr : Membership.mem I r
      hr' : ∀ (n : R), Membership.mem I n → Eq (HMul.hMul r n) n
      ⊢ Exists fun e => And (IsIdempotentElem e) (Eq I (Submodule.span R (Singleton. …
    -/
    refine ⟨r, hr' r hr, antisymm ?_ ((Submodule.span_singleton_le_iff_mem _ _).mpr hr)⟩
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      e : IsIdempotentElem I
      r : R
      hr : Membership.mem I r
      hr' : ∀ (n : R), Membership.mem I n → Eq (HMul.hMul r n) n
      ⊢ LE.le I (Submodule.span R (Singleton.singleton r))
    -/
    intro x hx
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      e : IsIdempotentElem I
      r : R
      hr : Membership.mem I r
      hr' : ∀ (n : R), Membership.mem I n → Eq (HMul.hMul r n) n
      x : R
      hx : Membership.mem I x
      ⊢ Membership.mem (Submodule.span R (Singleton.singleton r)) x
    -/
    rw [← hr' x hx]
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      e : IsIdempotentElem I
      r : R
      hr : Membership.mem I r
      hr' : ∀ (n : R), Membership.mem I n → Eq (HMul.hMul r n) n
      x : R
      hx : Membership.mem I x
      ⊢ Membership.mem (Submodule.span R (Singleton.singleton r)) (HMul.hMul r x)
    -/
    exact Ideal.mem_span_singleton'.mpr ⟨_, mul_comm _ _⟩
    /-
      🎉 no goals
    -/
    /-
      case mpr
      R : Type u_1
      inst✝ : CommRing R
      I : Ideal R
      h : I.FG
      ⊢ (Exists fun e => And (IsIdempotentElem e) (Eq I (Submodule.span R (Singleton …
    -/
  · rintro ⟨e, he, rfl⟩
    /-
      case mpr.intro.intro
      R : Type u_1
      inst✝ : CommRing R
      e : R
      he : IsIdempotentElem e
      h : Ideal.FG (Submodule.span R (Singleton.singleton e))
      ⊢ IsIdempotentElem (Submodule.span R (Singleton.singleton e))
    -/
    simp [IsIdempotentElem, Ideal.span_singleton_mul_span_singleton, he.eq]
    /-
      🎉 no goals
    -/


theorem isIdempotentElem_iff_eq_bot_or_top {R : Type*} [CommRing R] [IsDomain R] (I : Ideal R)
    (h : I.FG) : IsIdempotentElem I ↔ I = ⊥ ∨ I = ⊤ := by
  /-
    R : Type u_1
    inst✝¹ : CommRing R
    inst✝ : IsDomain R
    I : Ideal R
    h : I.FG
    ⊢ Iff (IsIdempotentElem I) (Or (Eq I Bot.bot) (Eq I Top.top))
  -/
  constructor
    /-
      case mp
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      I : Ideal R
      h : I.FG
      ⊢ IsIdempotentElem I → Or (Eq I Bot.bot) (Eq I Top.top)
    -/
  · intro H
    /-
      case mp
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      I : Ideal R
      h : I.FG
      H : IsIdempotentElem I
      ⊢ Or (Eq I Bot.bot) (Eq I Top.top)
    -/
    obtain ⟨e, he, rfl⟩ := (I.isIdempotentElem_iff_of_fg h).mp H
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      e : R
      he : IsIdempotentElem e
      h : Ideal.FG (Submodule.span R (Singleton.singleton e))
      H : IsIdempotentElem (Submodule.span R (Singleton.singleton e))
      ⊢ Or (Eq (Submodule.span R (Singleton.singleton e)) Bot.bot) (Eq (Submodule.sp …
    -/
    simp only [Ideal.submodule_span_eq, Ideal.span_singleton_eq_bot]
    /-
      case mp.intro.intro
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      e : R
      he : IsIdempotentElem e
      h : Ideal.FG (Submodule.span R (Singleton.singleton e))
      H : IsIdempotentElem (Submodule.span R (Singleton.singleton e))
      ⊢ Or (Eq e 0) (Eq (Ideal.span (Singleton.singleton e)) Top.top)
    -/
    apply Or.imp id _ (IsIdempotentElem.iff_eq_zero_or_one.mp he)
    /-
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      e : R
      he : IsIdempotentElem e
      h : Ideal.FG (Submodule.span R (Singleton.singleton e))
      H : IsIdempotentElem (Submodule.span R (Singleton.singleton e))
      ⊢ Eq e 1 → Eq (Ideal.span (Singleton.singleton e)) Top.top
    -/
    rintro rfl
    /-
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      he : IsIdempotentElem 1
      h : Ideal.FG (Submodule.span R (Singleton.singleton 1))
      H : IsIdempotentElem (Submodule.span R (Singleton.singleton 1))
      ⊢ Eq (Ideal.span (Singleton.singleton 1)) Top.top
    -/
    simp
    /-
      🎉 no goals
    -/
    /-
      case mpr
      R : Type u_1
      inst✝¹ : CommRing R
      inst✝ : IsDomain R
      I : Ideal R
      h : I.FG
      ⊢ Or (Eq I Bot.bot) (Eq I Top.top) → IsIdempotentElem I
    -/
                           /-
                             🎉 no goals
                           -/
  · rintro (rfl | rfl) <;> simp [IsIdempotentElem]
                           /-
                             🎉 no goals
                           -/


