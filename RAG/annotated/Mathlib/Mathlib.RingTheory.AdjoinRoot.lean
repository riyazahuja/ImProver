    h : Eq (ϕ.comp (AdjoinRoot.of f)) (algebraMap R S)
    ⊢ Eq (Polynomial.eval₂ (ϕ.comp (AdjoinRoot.of f)) (ϕ (AdjoinRoot.root f)) f) ( …
  -/
  rfl
  /-
    🎉 no goals
  -/


