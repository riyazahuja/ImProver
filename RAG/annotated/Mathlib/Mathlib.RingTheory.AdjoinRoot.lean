  /-
    🎉 no goals
  -/


@[simp]
theorem liftHom_mk {g : R[X]} : liftHom f a hfx (mk f g) = aeval a g :=
  lift_mk hfx g


@[simp]
theorem liftHom_root : liftHom f a hfx (root f) = a :=
  lift_root hfx


@[simp]
theorem liftHom_of {x : R} : liftHom f a hfx (of f x) = algebraMap _ _ x :=
  lift_of hfx


