theorem adjoinRoot_eq_top : Algebra.adjoin R ({root f} : Set (AdjoinRoot f)) = ⊤ := by
  /-
    R : Type u
    inst✝ : CommRing R
    f : Polynomial R
    ⊢ Eq (Algebra.adjoin R (Singleton.singleton (AdjoinRoot.root f))) Top.top
  -/
  refine Algebra.eq_top_iff.2 fun x => ?_
  induction x using AdjoinRoot.induction_on with
    | ih p => exact (Algebra.adjoin_singleton_eq_range_aeval R (root f)).symm ▸ ⟨p, aeval_eq p⟩


@[simp]
theorem eval₂_root (f : R[X]) : f.eval₂ (of f) (root f) = 0 := by
  /-
    R : Type u
    inst✝ : CommRing R
    f : Polynomial R
    ⊢ Eq (Polynomial.eval₂ (AdjoinRoot.of f) (AdjoinRoot.root f) f) 0
  -/
  rw [← algebraMap_eq, ← aeval_def, aeval_eq, mk_self]
  /-
    🎉 no goals
  -/


theorem isRoot_root (f : R[X]) : IsRoot (f.map (of f)) (root f) := by
  /-
    R : Type u
    inst✝ : CommRing R
    f : Polynomial R
    ⊢ (Polynomial.map (AdjoinRoot.of f) f).IsRoot (AdjoinRoot.root f)
  -/
  rw [IsRoot, eval_map, eval₂_root]
  /-
    🎉 no goals
  -/


theorem isAlgebraic_root (hf : f ≠ 0) : IsAlgebraic R (root f) :=
  ⟨f, hf, eval₂_root f⟩


theorem of.injective_of_degree_ne_zero [IsDomain R] (hf : f.degree ≠ 0) :
    Function.Injective (AdjoinRoot.of f) := by
  /-
    R : Type u
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : IsDomain R
    hf : Ne f.degree 0
    ⊢ Function.Injective ⇑(AdjoinRoot.of f)
  -/
  rw [injective_iff_map_eq_zero]
  /-
    R : Type u
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : IsDomain R
    hf : Ne f.degree 0
    ⊢ ∀ (a : R), Eq ((AdjoinRoot.of f) a) 0 → Eq a 0
  -/
  intro p hp
  /-
    R : Type u
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : IsDomain R
    hf : Ne f.degree 0
    p : R
    hp : Eq ((AdjoinRoot.of f) p) 0
    ⊢ Eq p 0
  -/
  rw [AdjoinRoot.of, RingHom.comp_apply, AdjoinRoot.mk_eq_zero] at hp
  /-
    R : Type u
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : IsDomain R
    hf : Ne f.degree 0
    p : R
    hp : Dvd.dvd f (Polynomial.C p)
    ⊢ Eq p 0
  -/
  by_cases h : f = 0
    /-
      case pos
      R : Type u
      inst✝¹ : CommRing R
      f : Polynomial R
      inst✝ : IsDomain R
      hf : Ne f.degree 0
      p : R
      hp : Dvd.dvd f (Polynomial.C p)
      h : Eq f 0
      ⊢ Eq p 0
    -/
  · exact C_eq_zero.mp (eq_zero_of_zero_dvd (by rwa [h] at hp))
    /-
      🎉 no goals
    -/
    /-
      case neg
      R : Type u
      inst✝¹ : CommRing R
      f : Polynomial R
      inst✝ : IsDomain R
      hf : Ne f.degree 0
      p : R
      hp : Dvd.dvd f (Polynomial.C p)
      h : Not (Eq f 0)
      ⊢ Eq p 0
    -/
  · contrapose! hf with h_contra
    /-
      case neg
      R : Type u
      inst✝¹ : CommRing R
      f : Polynomial R
      inst✝ : IsDomain R
      p : R
      hp : Dvd.dvd f (Polynomial.C p)
      h : Not (Eq f 0)
      h_contra : Ne p 0
      ⊢ Eq f.degree 0
    -/
    rw [← degree_C h_contra]
    /-
      case neg
      R : Type u
      inst✝¹ : CommRing R
      f : Polynomial R
      inst✝ : IsDomain R
      p : R
      hp : Dvd.dvd f (Polynomial.C p)
      h : Not (Eq f 0)
      h_contra : Ne p 0
      ⊢ Eq f.degree (Polynomial.C p).degree
    -/
    apply le_antisymm (degree_le_of_dvd hp (by rwa [Ne, C_eq_zero])) _
    /-
      R : Type u
      inst✝¹ : CommRing R
      f : Polynomial R
      inst✝ : IsDomain R
      p : R
      hp : Dvd.dvd f (Polynomial.C p)
      h : Not (Eq f 0)
      h_contra : Ne p 0
      ⊢ LE.le (Polynomial.C p).degree f.degree
    -/
    rwa [degree_C h_contra, zero_le_degree_iff]
    /-
      🎉 no goals
    -/


/-- Lift a ring homomorphism `i : R →+* S` to `AdjoinRoot f →+* S`. -/
def lift (i : R →+* S) (x : S) (h : f.eval₂ i x = 0) : AdjoinRoot f →+* S := by
  /-
    R : Type u
    S : Type v
    K : Type w
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : CommRing S
    i : RingHom R S
    x : S
    h : Eq (Polynomial.eval₂ i x f) 0
    ⊢ RingHom (AdjoinRoot f) S
  -/
  apply Ideal.Quotient.lift _ (eval₂RingHom i x)
  /-
    R : Type u
    S : Type v
    K : Type w
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : CommRing S
    i : RingHom R S
    x : S
    h : Eq (Polynomial.eval₂ i x f) 0
    ⊢ ∀ (a : Polynomial R), Membership.mem (Ideal.span (Singleton.singleton f)) a  …
  -/
  intro g H
  /-
    R : Type u
    S : Type v
    K : Type w
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : CommRing S
    i : RingHom R S
    x : S
    h : Eq (Polynomial.eval₂ i x f) 0
    g : Polynomial R
    H : Membership.mem (Ideal.span (Singleton.singleton f)) g
    ⊢ Eq ((Polynomial.eval₂RingHom i x) g) 0
  -/
  rcases mem_span_singleton.1 H with ⟨y, hy⟩
  /-
    case intro
    R : Type u
    S : Type v
    K : Type w
    inst✝¹ : CommRing R
    f : Polynomial R
    inst✝ : CommRing S
    i : RingHom R S
    x : S
    h : Eq (Polynomial.eval₂ i x f) 0
    g : Polynomial R
    H : Membership.mem (Ideal.span (Singleton.singleton f)) g
    y : Polynomial R
    hy : Eq g (HMul.hMul f y)
    ⊢ Eq ((Polynomial.eval₂RingHom i x) g) 0
  -/
  rw [hy, RingHom.map_mul, coe_eval₂RingHom, h, zero_mul]
  /-
    🎉 no goals
  -/


@[simp]
theorem lift_mk (g : R[X]) : lift i a h (mk f g) = g.eval₂ i a :=
  Ideal.Quotient.lift_mk _ _ _


@[simp]
                                                  /-
                                                    R : Type u
                                                    S : Type v
                                                    inst✝¹ : CommRing R
                                                    f : Polynomial R
                                                    inst✝ : CommRing S
                                                    i : RingHom R S
                                                    a : S
                                                    h : Eq (Polynomial.eval₂ i a f) 0
                                                    ⊢ Eq ((AdjoinRoot.lift i a h) (AdjoinRoot.root f)) a
                                                  -/
theorem lift_root : lift i a h (root f) = a := by rw [root, lift_mk, eval₂_X]
                                                  /-
                                                    🎉 no goals
                                                  -/


@[simp]
                                                   /-
                                                     R : Type u
                                                     S : Type v
                                                     inst✝¹ : CommRing R
                                                     f : Polynomial R
                                                     inst✝ : CommRing S
                                                     i : RingHom R S
                                                     a : S
                                                     h : Eq (Polynomial.eval₂ i a f) 0
                                                     x : R
                                                     ⊢ Eq ((AdjoinRoot.lift i a h) ((AdjoinRoot.of f) x)) (i x)
                                                   -/
theorem lift_of {x : R} : lift i a h x = i x := by rw [← mk_C x, lift_mk, eval₂_C]
                                                   /-
                                                     🎉 no goals
                                                   -/


@[simp]
theorem lift_comp_of : (lift i a h).comp (of f) = i :=
  RingHom.ext fun _ => @lift_of _ _ _ _ _ _ _ h _


/-- Produce an algebra homomorphism `AdjoinRoot f →ₐ[R] S` sending `root f` to
a root of `f` in `S`. -/
def liftHom (x : S) (hfx : aeval x f = 0) : AdjoinRoot f →ₐ[R] S :=
  { lift (algebraMap R S) x hfx with
    commutes' := fun r => show lift _ _ hfx r = _ from lift_of hfx }


@[simp]
theorem coe_liftHom (x : S) (hfx : aeval x f = 0) :
    (liftHom f x hfx : AdjoinRoot f →+* S) = lift (algebraMap R S) x hfx :=
  rfl


@[simp]
theorem aeval_algHom_eq_zero (ϕ : AdjoinRoot f →ₐ[R] S) : aeval (ϕ (root f)) f = 0 := by
  /-
    R : Type u
    S : Type v
    inst✝² : CommRing R
    f : Polynomial R
    inst✝¹ : CommRing S
    inst✝ : Algebra R S
