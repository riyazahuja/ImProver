/-- The submodule generated by a supremum of finite dimensional submodules, indexed by a finite
sort is finite-dimensional. -/
instance finite_iSup {ι : Sort*} [Finite ι] (S : ι → Submodule R V)
    [∀ i, Module.Finite R (S i)] : Module.Finite R ↑(⨆ i, S i) := by
  /-
    R : Type u_2
    V : Type u_3
    inst✝⁴ : Ring R
    inst✝³ : AddCommGroup V
    inst✝² : Module R V
    ι : Sort u_1
    inst✝¹ : Finite ι
    S : ι → Submodule R V
    inst✝ : ∀ (i : ι), Module.Finite R (Subtype fun x => Membership.mem (S i) x)
    ⊢ Module.Finite R (Subtype fun x => Membership.mem (iSup fun i => S i) x)
  -/
  cases nonempty_fintype (PLift ι)
  /-
    case intro
    R : Type u_2
    V : Type u_3
    inst✝⁴ : Ring R
    inst✝³ : AddCommGroup V
    inst✝² : Module R V
    ι : Sort u_1
    inst✝¹ : Finite ι
    S : ι → Submodule R V
    inst✝ : ∀ (i : ι), Module.Finite R (Subtype fun x => Membership.mem (S i) x)
    val✝ : Fintype (PLift ι)
    ⊢ Module.Finite R (Subtype fun x => Membership.mem (iSup fun i => S i) x)
  -/
  rw [← iSup_plift_down, ← Finset.sup_univ_eq_iSup]
  /-
    case intro
    R : Type u_2
    V : Type u_3
    inst✝⁴ : Ring R
    inst✝³ : AddCommGroup V
    inst✝² : Module R V
    ι : Sort u_1
    inst✝¹ : Finite ι
    S : ι → Submodule R V
    inst✝ : ∀ (i : ι), Module.Finite R (Subtype fun x => Membership.mem (S i) x)
    val✝ : Fintype (PLift ι)
    ⊢ Module.Finite R (Subtype fun x => Membership.mem (Finset.univ.sup fun i => S …
  -/
  exact Submodule.finite_finset_sup _ _
  /-
    🎉 no goals
  -/


