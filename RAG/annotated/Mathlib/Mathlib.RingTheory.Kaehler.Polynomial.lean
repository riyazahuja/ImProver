    inst✝ : CommRing R
    P : Polynomial R
    ⊢ Eq ((KaehlerDifferential.D R (Polynomial R)) P) (HSMul.hSMul (Polynomial.der …
  -/
  rw [← aeval_X_left_apply P, (D R R[X]).map_aeval, aeval_X_left_apply, aeval_X_left_apply]
  /-
    🎉 no goals
  -/


