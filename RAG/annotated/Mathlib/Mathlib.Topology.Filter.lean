    α : Type u_2
    l₁ l₂ : Filter α
    h : LE.le (nhds l₁) (nhds l₂)
    ⊢ LE.le l₁ l₂
  -/
  rw [← Iic_subset_Iic, ← sInter_nhds, ← sInter_nhds]
