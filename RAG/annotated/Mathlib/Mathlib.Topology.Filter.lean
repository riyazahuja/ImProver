theorem nhds_bot : 𝓝 (⊥ : Filter α) = pure ⊥ := by
  /-
    α : Type u_2
    ⊢ Eq (nhds Bot.bot) (Pure.pure Bot.bot)
  -/
  simp [nhds_eq, Function.comp_def, lift'_bot monotone_principal.Iic]
  /-
    🎉 no goals
  -/


@[simp]
                                              /-
                                                α : Type u_2
                                                ⊢ Eq (nhds Top.top) Top.top
                                              -/
