  -/


@[simp]
theorem nhds_iInf (f : ι → Filter α) : 𝓝 (⨅ i, f i) = ⨅ i, 𝓝 (f i) := by
  /-
    ι : Sort u_1
    α : Type u_2
    f : ι → Filter α
    ⊢ Eq (nhds (iInf fun i => f i)) (iInf fun i => nhds (f i))
  -/
  simp only [nhds_eq]
  /-
    ι : Sort u_1
    α : Type u_2
    f : ι → Filter α
    ⊢ Eq ((iInf fun i => f i).lift' (Function.comp Set.Iic Filter.principal)) (iIn …
  -/
