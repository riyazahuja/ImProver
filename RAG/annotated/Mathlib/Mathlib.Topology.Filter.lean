    α : Type u_2
    l₁ l₂ : Filter α
    h : LE.le (nhds l₁) (nhds l₂)
    ⊢ HasSubset.Subset (setOf fun s => Membership.mem (nhds l₁) s).sInter (setOf f …
  -/
  exact sInter_subset_sInter h
  /-
    🎉 no goals
  -/


