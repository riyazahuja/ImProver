/-- Normal closures of `K/F` are unique up to F-algebra isomorphisms. -/
noncomputable def IsNormalClosure.equiv {L'} [Field L'] [Algebra F L']
    [h : IsNormalClosure F K L] [h' : IsNormalClosure F K L'] : L ≃ₐ[F] L' :=
  have := h.normal
  AlgEquiv.ofBijective _ <| And.left <|
    Normal.toIsAlgebraic.algHom_bijective₂
      (IsNormalClosure.lift fun _ : K ↦ h'.splits _)
      (IsNormalClosure.lift fun _ : K ↦ h.splits _)


instance isNormalClosure_normalClosure [ne : Nonempty (K →ₐ[F] L)] [h : Normal F L] :
    IsNormalClosure F K (normalClosure F K L) := by
  /-
    F : Type u_1
    K : Type u_2
    L : Type u_3
    inst✝⁴ : Field F
    inst✝³ : Field K
    inst✝² : Field L
    inst✝¹ : Algebra F K
    inst✝ : Algebra F L
    ne : Nonempty (AlgHom F K L)
    h : Normal F L
    ⊢ IsNormalClosure F K (Subtype fun x => Membership.mem (normalClosure F K L) x)
  -/
  have ⟨φ⟩ := ne
  /-
    F : Type u_1
    K : Type u_2
    L : Type u_3
    inst✝⁴ : Field F
    inst✝³ : Field K
    inst✝² : Field L
    inst✝¹ : Algebra F K
    inst✝ : Algebra F L
    ne : Nonempty (AlgHom F K L)
    h : Normal F L
    φ : AlgHom F K L
    ⊢ IsNormalClosure F K (Subtype fun x => Membership.mem (normalClosure F K L) x)
  -/
  apply (h.toIsAlgebraic.of_injective φ φ.injective).isNormalClosure_normalClosure
  /-
    F : Type u_1
    K : Type u_2
    L : Type u_3
    inst✝⁴ : Field F
    inst✝³ : Field K
    inst✝² : Field L
    inst✝¹ : Algebra F K
    inst✝ : Algebra F L
    ne : Nonempty (AlgHom F K L)
    h : Normal F L
    φ : AlgHom F K L
    ⊢ ∀ (x : K), Polynomial.Splits (algebraMap F L) (minpoly F x)
  -/
  simp_rw [← minpoly.algHom_eq _ φ.injective]
  /-
    F : Type u_1
    K : Type u_2
    L : Type u_3
    inst✝⁴ : Field F
    inst✝³ : Field K
    inst✝² : Field L
    inst✝¹ : Algebra F K
    inst✝ : Algebra F L
    ne : Nonempty (AlgHom F K L)
    h : Normal F L
    φ : AlgHom F K L
    ⊢ ∀ (x : K), Polynomial.Splits (algebraMap F L) (minpoly F (φ x))
  -/
  exact fun _ ↦ h.splits _
  /-
    🎉 no goals
  -/


