      val✝ : Fintype W
      this✝ : ∀ (G' : Opposite G.Finsubgraph), Nonempty ((G.finsubgraphHomFunctor F) …
      this : (G' : Opposite G.Finsubgraph) → Fintype ((G.finsubgraphHomFunctor F).ob …
