      val✝ : Fintype W
      this✝ : ∀ (G' : Opposite G.Finsubgraph), Nonempty ((G.finsubgraphHomFunctor F) …
      this : (G' : Opposite G.Finsubgraph) → Fintype ((G.finsubgraphHomFunctor F).ob …
      u : (j : Opposite G.Finsubgraph) → (G.finsubgraphHomFunctor F).obj j
      hu : Membership.mem (G.finsubgraphHomFunctor F).sections u
      v v' : V
      e : G.Adj v v'
