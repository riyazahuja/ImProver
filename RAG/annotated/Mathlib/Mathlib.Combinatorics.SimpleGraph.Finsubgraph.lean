      hv' : Quiver.Hom { unop := SimpleGraph.finsubgraphOfAdj e } { unop := SimpleGr …
      ⊢ F.Adj ((u { unop := SimpleGraph.singletonFinsubgraph v }).toFun ⟨v, ⋯⟩) ((u  …
