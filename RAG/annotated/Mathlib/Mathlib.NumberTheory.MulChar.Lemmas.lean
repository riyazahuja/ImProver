      ⊢ Eq ((fun χ => ⟨χ.toUnitHom (Classical.choose ⋯), ⋯⟩) ((fun ζ => MulChar.ofRo …
    -/
    ext
    /-
      case a.a
      M : Type u_1
      inst✝³ : CommMonoid M
      inst✝² : Fintype M
