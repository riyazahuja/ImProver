/-- Two multiplicative characters on a monoid whose unit group is generated by `g`
are equal if and only if they agree on `g`. -/
lemma eq_iff {R R' : Type*} [CommMonoid R] [CommMonoidWithZero R'] {g : Rˣ}
    (hg : ∀ x, x ∈ Subgroup.zpowers g) (χ₁ χ₂ : MulChar R R') :
    χ₁ = χ₂ ↔ χ₁ g.val = χ₂ g.val := by
  rw [← Equiv.apply_eq_iff_eq equivToUnitHom, MonoidHom.eq_iff_eq_on_generator hg,
    ← coe_equivToUnitHom, ← coe_equivToUnitHom, Units.ext_iff]



/-- Define the conjugation (`star`) of a multiplicative character by conjugating pointwise. -/
@[simps!]
def starComp [StarRing R'] (χ : MulChar R R') : MulChar R R' :=
  χ.ringHomComp (starRingEnd R')


instance instStarMul [StarRing R'] : StarMul (MulChar R R') where
  star := starComp
  star_involutive χ := by
    /-
      R : Type u_1
      R' : Type u_2
      inst✝² : CommRing R
      inst✝¹ : CommRing R'
      inst✝ : StarRing R'
      χ : MulChar R R'
      ⊢ Eq (Star.star (Star.star χ)) χ
    -/
    ext1
    /-
      case h
      R : Type u_1
      R' : Type u_2
      inst✝² : CommRing R
      inst✝¹ : CommRing R'
      inst✝ : StarRing R'
      χ : MulChar R R'
      a✝ : Units R
      ⊢ Eq ((Star.star (Star.star χ)) ↑a✝) (χ ↑a✝)
    -/
    simp only [starComp_apply, RingHomCompTriple.comp_apply, RingHom.id_apply]
    /-
      🎉 no goals
    -/
  star_mul χ χ' := by
    /-
      R : Type u_1
      R' : Type u_2
      inst✝² : CommRing R
      inst✝¹ : CommRing R'
      inst✝ : StarRing R'
      χ χ' : MulChar R R'
      ⊢ Eq (Star.star (HMul.hMul χ χ')) (HMul.hMul (Star.star χ') (Star.star χ))
    -/
    ext1
    simp only [starComp_apply, starRingEnd, coeToFun_mul, Pi.mul_apply, map_mul, RingHom.coe_coe,
      starRingAut_apply, mul_comm]


@[simp]
lemma star_apply [StarRing R'] (χ : MulChar R R') (a : R) : (star χ) a = star (χ a) :=
  rfl


/-- The values of a multiplicative character on `R` are `n`th roots of unity, where `n = #Rˣ`. -/
lemma apply_mem_rootsOfUnity [Fintype Rˣ] (a : Rˣ) {χ : MulChar R R'} :
    equivToUnitHom χ a ∈ rootsOfUnity (Fintype.card Rˣ) R' := by
  /-
    R : Type u_1
    R' : Type u_2
    inst✝² : CommRing R
    inst✝¹ : CommRing R'
    inst✝ : Fintype (Units R)
    a : Units R
    χ : MulChar R R'
    ⊢ Membership.mem (rootsOfUnity (Fintype.card (Units R)) R') ((MulChar.equivToU …
  -/
  rw [mem_rootsOfUnity, ← map_pow, ← (equivToUnitHom χ).map_one, pow_card_eq_one]
  /-
    🎉 no goals
  -/


open Complex in
/-- The conjugate of a multiplicative character with values in `ℂ` is its inverse. -/
lemma star_eq_inv (χ : MulChar R ℂ) : star χ = χ⁻¹ := by
  /-
    R : Type u_1
    inst✝¹ : CommRing R
    inst✝ : Finite (Units R)
    χ : MulChar R Complex
    ⊢ Eq (Star.star χ) (Inv.inv χ)
  -/
  cases nonempty_fintype Rˣ
  /-
    case intro
    R : Type u_1
    inst✝¹ : CommRing R
    inst✝ : Finite (Units R)
    χ : MulChar R Complex
    val✝ : Fintype (Units R)
    ⊢ Eq (Star.star χ) (Inv.inv χ)
  -/
  ext1 a
  /-
    case intro.h
    R : Type u_1
    inst✝¹ : CommRing R
    inst✝ : Finite (Units R)
    χ : MulChar R Complex
    val✝ : Fintype (Units R)
    a : Units R
    ⊢ Eq ((Star.star χ) ↑a) ((Inv.inv χ) ↑a)
  -/
  simp only [inv_apply_eq_inv']
  /-
    case intro.h
    R : Type u_1
    inst✝¹ : CommRing R
    inst✝ : Finite (Units R)
    χ : MulChar R Complex
    val✝ : Fintype (Units R)
    a : Units R
    ⊢ Eq ((Star.star χ) ↑a) (Inv.inv (χ ↑a))
  -/
  exact (inv_eq_conj <| norm_eq_one_of_mem_rootsOfUnity <| χ.apply_mem_rootsOfUnity a).symm
  /-
    🎉 no goals
  -/


lemma star_apply' (χ : MulChar R ℂ) (a : R) : star (χ a) = χ⁻¹ a := by
  /-
    R : Type u_1
    inst✝¹ : CommRing R
    inst✝ : Finite (Units R)
    χ : MulChar R Complex
    a : R
    ⊢ Eq (Star.star (χ a)) ((Inv.inv χ) a)
  -/
  simp only [RCLike.star_def, ← star_eq_inv, star_apply]
  /-
    🎉 no goals
  -/


/-- Given a finite monoid `M` with unit group `Mˣ` cyclic of order `n` and an `n`th root of
unity `ζ` in `R`, there is a multiplicative character `M → R` that sends a given generator
of `Mˣ` to `ζ`. -/
noncomputable def ofRootOfUnity {ζ : Rˣ} (hζ : ζ ∈ rootsOfUnity (Fintype.card Mˣ) R)
    {g : Mˣ} (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    MulChar M R := by
  have : orderOf ζ ∣ Fintype.card Mˣ :=
    orderOf_dvd_iff_pow_eq_one.mpr <| (mem_rootsOfUnity _ ζ).mp hζ
  /-
    M : Type u_1
    inst✝³ : CommMonoid M
    inst✝² : Fintype M
    inst✝¹ : DecidableEq M
    R : Type u_2
    inst✝ : CommMonoidWithZero R
    ζ : Units R
    hζ : Membership.mem (rootsOfUnity (Fintype.card (Units M)) R) ζ
    g : Units M
    hg : ∀ (x : Units M), Membership.mem (Subgroup.zpowers g) x
    this : Dvd.dvd (orderOf ζ) (Fintype.card (Units M))
    ⊢ MulChar M R
  -/
  refine ofUnitHom <| monoidHomOfForallMemZpowers hg <| this.trans <| dvd_of_eq ?_
  /-
    M : Type u_1
    inst✝³ : CommMonoid M
    inst✝² : Fintype M
    inst✝¹ : DecidableEq M
    R : Type u_2
    inst✝ : CommMonoidWithZero R
    ζ : Units R
    hζ : Membership.mem (rootsOfUnity (Fintype.card (Units M)) R) ζ
    g : Units M
    hg : ∀ (x : Units M), Membership.mem (Subgroup.zpowers g) x
    this : Dvd.dvd (orderOf ζ) (Fintype.card (Units M))
    ⊢ Eq (Fintype.card (Units M)) (orderOf g)
  -/
  rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_eq_fintype_card]
  /-
    🎉 no goals
  -/


lemma ofRootOfUnity_spec {ζ : Rˣ} (hζ : ζ ∈ rootsOfUnity (Fintype.card Mˣ) R)
    {g : Mˣ} (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    ofRootOfUnity hζ hg g = ζ := by
  simp only [ofRootOfUnity, ofUnitHom_eq, equivToUnitHom_symm_coe,
    monoidHomOfForallMemZpowers_apply_gen]


variable (M R) in
