/-- There is a character of order `n` on `F` if `#F ≡ 1 mod n` and the target contains
a primitive `n`th root of unity. -/
lemma exists_mulChar_orderOf {n : ℕ} (h : n ∣ Fintype.card F - 1) {ζ : R}
    (hζ : IsPrimitiveRoot ζ n) :
    ∃ χ : MulChar F R, orderOf χ = n := by
  classical
  have hn₀ : 0 < n := by
    refine Nat.pos_of_ne_zero fun hn ↦ ?_
    simp only [hn, zero_dvd_iff, Nat.sub_eq_zero_iff_le] at h
    exact (Fintype.one_lt_card.trans_le h).false
  let e := MulChar.equiv_rootsOfUnity F R
  let ζ' : Rˣ := (hζ.isUnit hn₀).unit
  have h' : ζ' ^ (Fintype.card Fˣ : ℕ) = 1 :=
    Units.ext_iff.mpr <| (hζ.pow_eq_one_iff_dvd _).mpr <| Fintype.card_units (α := F) ▸ h
  use e.symm ⟨ζ', (mem_rootsOfUnity (Fintype.card Fˣ) ζ').mpr h'⟩
  rw [e.symm.orderOf_eq, orderOf_eq_iff hn₀]
  refine ⟨?_, fun m hm hm₀ h ↦ ?_⟩
  · ext
    push_cast
    exact hζ.pow_eq_one
  · rw [Subtype.ext_iff, Units.ext_iff] at h
    push_cast at h
    exact ((Nat.le_of_dvd hm₀ <| hζ.dvd_of_pow_eq_one _ h).trans_lt hm).false


/-- If there is a multiplicative character of order `n` on `F`, then `#F ≡ 1 mod n`. -/
lemma orderOf_dvd_card_sub_one (χ : MulChar F R) : orderOf χ ∣ Fintype.card F - 1 := by
  classical
  rw [← Fintype.card_units]
  exact orderOf_dvd_of_pow_eq_one χ.pow_card_eq_one


/-- There is always a character on `F` of order `#F-1` with values in a ring that has
a primitive `(#F-1)`th root of unity. -/
lemma exists_mulChar_orderOf_eq_card_units [DecidableEq F]
    {ζ : R} (hζ : IsPrimitiveRoot ζ (Fintype.card Fˣ)) :
    ∃ χ : MulChar F R, orderOf χ = Fintype.card Fˣ :=
                               /-
                                 F : Type u_1
                                 inst✝³ : Field F
                                 inst✝² : Fintype F
                                 R : Type u_2
                                 inst✝¹ : CommRing R
                                 inst✝ : DecidableEq F
                                 ζ : R
                                 hζ : IsPrimitiveRoot ζ (Fintype.card (Units F))
                                 ⊢ Dvd.dvd (Fintype.card (Units F)) (HSub.hSub (Fintype.card F) 1)
                               -/
  exists_mulChar_orderOf F (by rw [Fintype.card_units]) hζ
                               /-
                                 🎉 no goals
                               -/


lemma apply_mem_rootsOfUnity_orderOf (χ : MulChar F R) {a : F} (ha : a ≠ 0) :
    ∃ ζ ∈ rootsOfUnity (orderOf χ) R, ζ = χ a := by
  /-
    F : Type u_1
    inst✝² : Field F
    inst✝¹ : Finite F
    R : Type u_2
    inst✝ : CommRing R
    χ : MulChar F R
    a : F
    ha : Ne a 0
    ⊢ Exists fun ζ => And (Membership.mem (rootsOfUnity (orderOf χ) R) ζ) (Eq (↑ζ) …
  -/
  have hu : IsUnit (χ a) := ha.isUnit.map χ
  /-
    F : Type u_1
    inst✝² : Field F
    inst✝¹ : Finite F
    R : Type u_2
    inst✝ : CommRing R
    χ : MulChar F R
    a : F
    ha : Ne a 0
    hu : IsUnit (χ a)
    ⊢ Exists fun ζ => And (Membership.mem (rootsOfUnity (orderOf χ) R) ζ) (Eq (↑ζ) …
  -/
  refine ⟨hu.unit, ?_, hu.unit_spec⟩
  rw [mem_rootsOfUnity, Units.ext_iff, Units.val_pow_eq_pow_val, Units.val_one,
    IsUnit.unit_spec, ← χ.pow_apply' χ.orderOf_pos.ne', pow_orderOf_eq_one,
    show a = (isUnit_iff_ne_zero.mpr ha).unit by simp only [IsUnit.unit_spec],
    MulChar.one_apply_coe]


/-- The non-zero values of a multiplicative character `χ` such that `χ^n = 1`
are `n`th roots of unity. -/
lemma apply_mem_rootsOfUnity_of_pow_eq_one {χ : MulChar F R} {n : ℕ} (hχ : χ ^ n = 1)
    {a : F} (ha : a ≠ 0) :
    ∃ ζ ∈ rootsOfUnity n R, ζ = χ a := by
  /-
    F : Type u_1
    inst✝² : Field F
    inst✝¹ : Finite F
    R : Type u_2
    inst✝ : CommRing R
    χ : MulChar F R
    n : Nat
    hχ : Eq (HPow.hPow χ n) 1
    a : F
    ha : Ne a 0
    ⊢ Exists fun ζ => And (Membership.mem (rootsOfUnity n R) ζ) (Eq (↑ζ) (χ a))
  -/
  obtain ⟨μ, hμ₁, hμ₂⟩ := χ.apply_mem_rootsOfUnity_orderOf ha
  /-
    case intro.intro
    F : Type u_1
    inst✝² : Field F
    inst✝¹ : Finite F
    R : Type u_2
    inst✝ : CommRing R
    χ : MulChar F R
    n : Nat
    hχ : Eq (HPow.hPow χ n) 1
    a : F
    ha : Ne a 0
    μ : Units R
    hμ₁ : Membership.mem (rootsOfUnity (orderOf χ) R) μ
    hμ₂ : Eq (↑μ) (χ a)
    ⊢ Exists fun ζ => And (Membership.mem (rootsOfUnity n R) ζ) (Eq (↑ζ) (χ a))
  -/
  exact ⟨μ, rootsOfUnity_le_of_dvd (orderOf_dvd_of_pow_eq_one hχ) hμ₁, hμ₂⟩
  /-
    🎉 no goals
  -/

-- Results involving primitive roots of unity require `R` to be an integral domain.

/-- If `χ` is a multiplicative character with `χ^n = 1` and `μ` is a primitive `n`th root
of unity, then, for `a ≠ 0`, there is some `k` such that `χ a = μ^k`. -/
lemma exists_apply_eq_pow {χ : MulChar F R} {n : ℕ} [NeZero n] (hχ : χ ^ n = 1) {μ : R}
    (hμ : IsPrimitiveRoot μ n) {a : F} (ha : a ≠ 0) :
    ∃ k < n, χ a = μ ^ k := by
  /-
    F : Type u_1
    inst✝⁴ : Field F
    inst✝³ : Finite F
    R : Type u_2
    inst✝² : CommRing R
    inst✝¹ : IsDomain R
    χ : MulChar F R
    n : Nat
    inst✝ : NeZero n
    hχ : Eq (HPow.hPow χ n) 1
    μ : R
    hμ : IsPrimitiveRoot μ n
    a : F
    ha : Ne a 0
    ⊢ Exists fun k => And (LT.lt k n) (Eq (χ a) (HPow.hPow μ k))
  -/
  obtain ⟨ζ, hζ₁, hζ₂⟩ := apply_mem_rootsOfUnity_of_pow_eq_one hχ ha
  /-
    case intro.intro
    F : Type u_1
    inst✝⁴ : Field F
    inst✝³ : Finite F
    R : Type u_2
    inst✝² : CommRing R
    inst✝¹ : IsDomain R
    χ : MulChar F R
    n : Nat
    inst✝ : NeZero n
    hχ : Eq (HPow.hPow χ n) 1
    μ : R
    hμ : IsPrimitiveRoot μ n
    a : F
    ha : Ne a 0
    ζ : Units R
    hζ₁ : Membership.mem (rootsOfUnity n R) ζ
    hζ₂ : Eq (↑ζ) (χ a)
    ⊢ Exists fun k => And (LT.lt k n) (Eq (χ a) (HPow.hPow μ k))
  -/
  have hζ' : ζ.val ^ n = 1 := (mem_rootsOfUnity' n ↑ζ).mp hζ₁
  /-
    case intro.intro
    F : Type u_1
    inst✝⁴ : Field F
    inst✝³ : Finite F
    R : Type u_2
    inst✝² : CommRing R
    inst✝¹ : IsDomain R
    χ : MulChar F R
    n : Nat
    inst✝ : NeZero n
    hχ : Eq (HPow.hPow χ n) 1
    μ : R
    hμ : IsPrimitiveRoot μ n
    a : F
    ha : Ne a 0
    ζ : Units R
    hζ₁ : Membership.mem (rootsOfUnity n R) ζ
    hζ₂ : Eq (↑ζ) (χ a)
    hζ' : Eq (HPow.hPow (↑ζ) n) 1
    ⊢ Exists fun k => And (LT.lt k n) (Eq (χ a) (HPow.hPow μ k))
  -/
  obtain ⟨k, hk₁, hk₂⟩ := hμ.eq_pow_of_pow_eq_one hζ'
  /-
    case intro.intro.intro.intro
    F : Type u_1
    inst✝⁴ : Field F
    inst✝³ : Finite F
    R : Type u_2
    inst✝² : CommRing R
    inst✝¹ : IsDomain R
    χ : MulChar F R
    n : Nat
    inst✝ : NeZero n
    hχ : Eq (HPow.hPow χ n) 1
    μ : R
    hμ : IsPrimitiveRoot μ n
    a : F
    ha : Ne a 0
    ζ : Units R
    hζ₁ : Membership.mem (rootsOfUnity n R) ζ
    hζ₂ : Eq (↑ζ) (χ a)
    hζ' : Eq (HPow.hPow (↑ζ) n) 1
    k : Nat
    hk₁ : LT.lt k n
    hk₂ : Eq (HPow.hPow μ k) ↑ζ
    ⊢ Exists fun k => And (LT.lt k n) (Eq (χ a) (HPow.hPow μ k))
  -/
  exact ⟨k, hk₁, (hζ₂ ▸ hk₂).symm⟩
  /-
    🎉 no goals
  -/


/-- The values of a multiplicative character `χ` such that `χ^n = 1` are contained in `ℤ[μ]` when
`μ` is a primitive `n`th root of unity. -/
lemma apply_mem_algebraAdjoin_of_pow_eq_one {χ : MulChar F R} {n : ℕ} [NeZero n] (hχ : χ ^ n = 1)
    {μ : R} (hμ : IsPrimitiveRoot μ n) (a : F) :
    χ a ∈ Algebra.adjoin ℤ {μ} := by
  /-
    F : Type u_1
    inst✝⁴ : Field F
    inst✝³ : Finite F
    R : Type u_2
    inst✝² : CommRing R
    inst✝¹ : IsDomain R
    χ : MulChar F R
    n : Nat
    inst✝ : NeZero n
    hχ : Eq (HPow.hPow χ n) 1
    μ : R
    hμ : IsPrimitiveRoot μ n
    a : F
    ⊢ Membership.mem (Algebra.adjoin Int (Singleton.singleton μ)) (χ a)
  -/
  rcases eq_or_ne a 0 with rfl | h
    /-
      case inl
      F : Type u_1
      inst✝⁴ : Field F
      inst✝³ : Finite F
      R : Type u_2
      inst✝² : CommRing R
      inst✝¹ : IsDomain R
      χ : MulChar F R
      n : Nat
      inst✝ : NeZero n
      hχ : Eq (HPow.hPow χ n) 1
      μ : R
      hμ : IsPrimitiveRoot μ n
      ⊢ Membership.mem (Algebra.adjoin Int (Singleton.singleton μ)) (χ 0)
    -/
  · exact χ.map_zero ▸ Subalgebra.zero_mem _
    /-
      🎉 no goals
    -/
    /-
      case inr
      F : Type u_1
      inst✝⁴ : Field F
      inst✝³ : Finite F
      R : Type u_2
      inst✝² : CommRing R
      inst✝¹ : IsDomain R
      χ : MulChar F R
      n : Nat
      inst✝ : NeZero n
      hχ : Eq (HPow.hPow χ n) 1
      μ : R
      hμ : IsPrimitiveRoot μ n
      a : F
      h : Ne a 0
      ⊢ Membership.mem (Algebra.adjoin Int (Singleton.singleton μ)) (χ a)
    -/
  · obtain ⟨ζ, hζ₁, hζ₂⟩ := apply_mem_rootsOfUnity_of_pow_eq_one hχ h
    /-
      case inr.intro.intro
      F : Type u_1
      inst✝⁴ : Field F
      inst✝³ : Finite F
      R : Type u_2
      inst✝² : CommRing R
      inst✝¹ : IsDomain R
      χ : MulChar F R
      n : Nat
      inst✝ : NeZero n
      hχ : Eq (HPow.hPow χ n) 1
      μ : R
      hμ : IsPrimitiveRoot μ n
      a : F
      h : Ne a 0
      ζ : Units R
      hζ₁ : Membership.mem (rootsOfUnity n R) ζ
      hζ₂ : Eq (↑ζ) (χ a)
      ⊢ Membership.mem (Algebra.adjoin Int (Singleton.singleton μ)) (χ a)
    -/
    rw [mem_rootsOfUnity, Units.ext_iff, Units.val_pow_eq_pow_val] at hζ₁
    /-
      case inr.intro.intro
      F : Type u_1
      inst✝⁴ : Field F
      inst✝³ : Finite F
      R : Type u_2
      inst✝² : CommRing R
      inst✝¹ : IsDomain R
      χ : MulChar F R
      n : Nat
      inst✝ : NeZero n
      hχ : Eq (HPow.hPow χ n) 1
      μ : R
      hμ : IsPrimitiveRoot μ n
      a : F
      h : Ne a 0
      ζ : Units R
      hζ₁ : Eq (HPow.hPow (↑ζ) n) ↑1
      hζ₂ : Eq (↑ζ) (χ a)
      ⊢ Membership.mem (Algebra.adjoin Int (Singleton.singleton μ)) (χ a)
    -/
    obtain ⟨k, _, hk⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one hμ hζ₁
    /-
      case inr.intro.intro.intro.intro
      F : Type u_1
      inst✝⁴ : Field F
      inst✝³ : Finite F
      R : Type u_2
      inst✝² : CommRing R
      inst✝¹ : IsDomain R
      χ : MulChar F R
      n : Nat
      inst✝ : NeZero n
      hχ : Eq (HPow.hPow χ n) 1
      μ : R
      hμ : IsPrimitiveRoot μ n
      a : F
      h : Ne a 0
      ζ : Units R
      hζ₁ : Eq (HPow.hPow (↑ζ) n) ↑1
      hζ₂ : Eq (↑ζ) (χ a)
      k : Nat
      left✝ : LT.lt k n
      hk : Eq (HPow.hPow μ k) ↑ζ
      ⊢ Membership.mem (Algebra.adjoin Int (Singleton.singleton μ)) (χ a)
    -/
    exact hζ₂ ▸ hk ▸ Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton ℤ μ) k
    /-
      🎉 no goals
    -/


/-- The values of a multiplicative character of order `n` are contained in `ℤ[μ]` when
`μ` is a primitive `n`th root of unity. -/
lemma apply_mem_algebraAdjoin {χ : MulChar F R} {μ : R} (hμ : IsPrimitiveRoot μ (orderOf χ))
    (a : F) :
    χ a ∈ Algebra.adjoin ℤ {μ} :=
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  apply_mem_algebraAdjoin_of_pow_eq_one (pow_orderOf_eq_one χ) hμ a


