theorem span_singleton_eq_top {x} : span ({x} : Set α) = ⊤ ↔ IsUnit x := by
  /-
    α : Type u
    inst✝ : CommSemiring α
    x : α
    ⊢ Iff (Eq (Ideal.span (Singleton.singleton x)) Top.top) (IsUnit x)
  -/
  rw [isUnit_iff_dvd_one, ← span_singleton_le_span_singleton, span_singleton_one, eq_top_iff]
  /-
    🎉 no goals
  -/


