/-- The unit of the multiplication is `single 1 1`, i.e. the function
  that is `1` at `1` and zero elsewhere. -/
instance one : One (MonoidAlgebra k G) :=
  ⟨single 1 1⟩


theorem one_def : (1 : MonoidAlgebra k G) = single 1 1 :=
  rfl


@[simp]
theorem liftNC_one {g_hom : Type*} [FunLike g_hom G R] [OneHomClass g_hom G R]
    (f : k →+* R) (g : g_hom) :
                                      /-
                                        k : Type u₁
                                        G : Type u₂
                                        R : Type u_2
                                        inst✝⁴ : NonAssocSemiring R
                                        inst✝³ : Semiring k
                                        inst✝² : One G
                                        g_hom : Type u_3
                                        inst✝¹ : FunLike g_hom G R
                                        inst✝ : OneHomClass g_hom G R
                                        f : RingHom k R
                                        g : g_hom
                                        ⊢ Eq ((MonoidAlgebra.liftNC ↑f ⇑g) 1) 1
                                      -/
    liftNC (f : k →+ R) g 1 = 1 := by simp [one_def]
                                      /-
                                        🎉 no goals
                                      -/


