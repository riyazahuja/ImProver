/-- If `u` is a monotone function with linear ordered codomain and the range of `u` is not bounded
above, then `Tendsto u atTop atTop`. -/
theorem tendsto_atTop_atTop_of_monotone' [Preorder ι] [LinearOrder α] {u : ι → α} (h : Monotone u)
    (H : ¬BddAbove (range u)) : Tendsto u atTop atTop := by
  /-
    ι : Type u_1
    α : Type u_3
    inst✝¹ : Preorder ι
    inst✝ : LinearOrder α
    u : ι → α
    h : Monotone u
    H : Not (BddAbove (Set.range u))
    ⊢ Filter.Tendsto u Filter.atTop Filter.atTop
  -/
  apply h.tendsto_atTop_atTop
  /-
    ι : Type u_1
    α : Type u_3
    inst✝¹ : Preorder ι
    inst✝ : LinearOrder α
    u : ι → α
    h : Monotone u
    H : Not (BddAbove (Set.range u))
    ⊢ ∀ (b : α), Exists fun a => LE.le b (u a)
  -/
  intro b
  /-
    ι : Type u_1
    α : Type u_3
    inst✝¹ : Preorder ι
    inst✝ : LinearOrder α
    u : ι → α
    h : Monotone u
    H : Not (BddAbove (Set.range u))
    b : α
    ⊢ Exists fun a => LE.le b (u a)
  -/
  rcases not_bddAbove_iff.1 H b with ⟨_, ⟨N, rfl⟩, hN⟩
  /-
    case intro.intro.intro
    ι : Type u_1
    α : Type u_3
    inst✝¹ : Preorder ι
    inst✝ : LinearOrder α
    u : ι → α
    h : Monotone u
    H : Not (BddAbove (Set.range u))
    b : α
    N : ι
    hN : LT.lt b (u N)
    ⊢ Exists fun a => LE.le b (u a)
  -/
  exact ⟨N, le_of_lt hN⟩
  /-
    🎉 no goals
  -/


/-- If `u` is a monotone function with linear ordered codomain and the range of `u` is not bounded
below, then `Tendsto u atBot atBot`. -/
theorem tendsto_atBot_atBot_of_monotone' [Preorder ι] [LinearOrder α] {u : ι → α} (h : Monotone u)
    (H : ¬BddBelow (range u)) : Tendsto u atBot atBot :=
  @tendsto_atTop_atTop_of_monotone' ιᵒᵈ αᵒᵈ _ _ _ h.dual H


theorem unbounded_of_tendsto_atTop [NoMaxOrder β] (h : Tendsto f atTop atTop) :
    ¬BddAbove (range f) := by
  /-
    α : Type u_3
    β : Type u_4
    inst✝⁴ : Nonempty α
    inst✝³ : Preorder α
    inst✝² : IsDirected α fun x1 x2 => LE.le x1 x2
    inst✝¹ : Preorder β
    f : α → β
    inst✝ : NoMaxOrder β
    h : Filter.Tendsto f Filter.atTop Filter.atTop
    ⊢ Not (BddAbove (Set.range f))
  -/
  rintro ⟨M, hM⟩
  /-
    case intro
    α : Type u_3
    β : Type u_4
    inst✝⁴ : Nonempty α
    inst✝³ : Preorder α
    inst✝² : IsDirected α fun x1 x2 => LE.le x1 x2
    inst✝¹ : Preorder β
    f : α → β
    inst✝ : NoMaxOrder β
    h : Filter.Tendsto f Filter.atTop Filter.atTop
    M : β
    hM : Membership.mem (upperBounds (Set.range f)) M
    ⊢ False
  -/
  cases' mem_atTop_sets.mp (h <| Ioi_mem_atTop M) with a ha
  /-
    case intro.intro
    α : Type u_3
    β : Type u_4
    inst✝⁴ : Nonempty α
    inst✝³ : Preorder α
    inst✝² : IsDirected α fun x1 x2 => LE.le x1 x2
    inst✝¹ : Preorder β
    f : α → β
    inst✝ : NoMaxOrder β
    h : Filter.Tendsto f Filter.atTop Filter.atTop
    M : β
    hM : Membership.mem (upperBounds (Set.range f)) M
    a : α
    ha : ∀ (b : α), GE.ge b a → Membership.mem (Set.preimage f (Set.Ioi M)) b
    ⊢ False
  -/
  apply lt_irrefl M
  calc
    M < f a := ha a le_rfl
    _ ≤ M := hM (Set.mem_range_self a)


theorem unbounded_of_tendsto_atBot [NoMinOrder β] (h : Tendsto f atTop atBot) :
