/-- If `u` is a sequence which is unbounded above,
then after any point, it reaches a value strictly greater than all previous values.
-/
theorem high_scores [LinearOrder β] [NoMaxOrder β] {u : ℕ → β} (hu : Tendsto u atTop atTop) :
    ∀ N, ∃ n ≥ N, ∀ k < n, u k < u n := by
  /-
    β : Type u_4
    inst✝¹ : LinearOrder β
    inst✝ : NoMaxOrder β
    u : Nat → β
    hu : Filter.Tendsto u Filter.atTop Filter.atTop
    ⊢ ∀ (N : Nat), Exists fun n => And (GE.ge n N) (∀ (k : Nat), LT.lt k n → LT.lt …
  -/
  intro N
  obtain ⟨k : ℕ, - : k ≤ N, hku : ∀ l ≤ N, u l ≤ u k⟩ : ∃ k ≤ N, ∀ l ≤ N, u l ≤ u k :=
    exists_max_image _ u (finite_le_nat N) ⟨N, le_refl N⟩
  /-
    case intro.intro
    β : Type u_4
    inst✝¹ : LinearOrder β
    inst✝ : NoMaxOrder β
    u : Nat → β
    hu : Filter.Tendsto u Filter.atTop Filter.atTop
    N k : Nat
    hku : ∀ (l : Nat), LE.le l N → LE.le (u l) (u k)
    ⊢ Exists fun n => And (GE.ge n N) (∀ (k : Nat), LT.lt k n → LT.lt (u k) (u n))
  -/
  have ex : ∃ n ≥ N, u k < u n := exists_lt_of_tendsto_atTop hu _ _
  obtain ⟨n : ℕ, hnN : n ≥ N, hnk : u k < u n, hn_min : ∀ m, m < n → N ≤ m → u m ≤ u k⟩ :
      ∃ n ≥ N, u k < u n ∧ ∀ m, m < n → N ≤ m → u m ≤ u k := by
    rcases Nat.findX ex with ⟨n, ⟨hnN, hnk⟩, hn_min⟩
    push_neg at hn_min
    exact ⟨n, hnN, hnk, hn_min⟩
  /-
    case intro.intro.intro.intro.intro
    β : Type u_4
    inst✝¹ : LinearOrder β
    inst✝ : NoMaxOrder β
    u : Nat → β
    hu : Filter.Tendsto u Filter.atTop Filter.atTop
    N k : Nat
    hku : ∀ (l : Nat), LE.le l N → LE.le (u l) (u k)
    ex : Exists fun n => And (GE.ge n N) (LT.lt (u k) (u n))
    n : Nat
    hnN : GE.ge n N
    hnk : LT.lt (u k) (u n)
    hn_min : ∀ (m : Nat), LT.lt m n → LE.le N m → LE.le (u m) (u k)
    ⊢ Exists fun n => And (GE.ge n N) (∀ (k : Nat), LT.lt k n → LT.lt (u k) (u n))
  -/
  use n, hnN
  /-
    case right
    β : Type u_4
    inst✝¹ : LinearOrder β
    inst✝ : NoMaxOrder β
    u : Nat → β
    hu : Filter.Tendsto u Filter.atTop Filter.atTop
    N k : Nat
    hku : ∀ (l : Nat), LE.le l N → LE.le (u l) (u k)
    ex : Exists fun n => And (GE.ge n N) (LT.lt (u k) (u n))
    n : Nat
    hnN : GE.ge n N
    hnk : LT.lt (u k) (u n)
    hn_min : ∀ (m : Nat), LT.lt m n → LE.le N m → LE.le (u m) (u k)
    ⊢ ∀ (k : Nat), LT.lt k n → LT.lt (u k) (u n)
  -/
  rintro (l : ℕ) (hl : l < n)
  have hlk : u l ≤ u k := by
    cases' (le_total l N : l ≤ N ∨ N ≤ l) with H H
    · exact hku l H
    · exact hn_min l hl H
  calc
    u l ≤ u k := hlk
    _ < u n := hnk

