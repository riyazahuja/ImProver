    inst✝² : IsDirected α fun x1 x2 => LE.le x1 x2
    inst✝¹ : Preorder β
    inst✝ : IsDirected β fun x1 x2 => LE.le x1 x2
    f : α → β
    hf : Monotone f
    b : β
    this : Nonempty α
