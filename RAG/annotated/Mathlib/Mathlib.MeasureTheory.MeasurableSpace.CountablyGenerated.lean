    x y : α
    h : Ne x y
    ⊢ Exists fun s => And (MeasurableSet s) (And (Membership.mem s x) (Not (Member …
  -/
  contrapose! h
  /-
    α : Type u_1
    inst✝¹ : MeasurableSpace α
    inst✝ : MeasurableSpace.SeparatesPoints α
    x y : α
    h : ∀ (s : Set α), MeasurableSet s → Membership.mem s x → Membership.mem s y
    ⊢ Eq x y
  -/
  exact separatesPoints_def h
  /-
    🎉 no goals
  -/


theorem separatesPoints_iff [MeasurableSpace α] : SeparatesPoints α ↔
    ∀ x y : α, (∀ s, MeasurableSet s → (x ∈ s ↔ y ∈ s)) → x = y :=
