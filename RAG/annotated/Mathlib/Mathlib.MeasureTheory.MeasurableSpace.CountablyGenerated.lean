    CountableOrCountablyGenerated α β := ⟨Or.inl h1⟩


instance instCountableOrCountablyGeneratedOfCountablyGenerated [h : CountablyGenerated β] :
    CountableOrCountablyGenerated α β := ⟨Or.inr h⟩


