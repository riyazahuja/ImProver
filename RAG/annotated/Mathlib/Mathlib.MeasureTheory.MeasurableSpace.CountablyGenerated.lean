    fun h ↦ ⟨fun _ _ hxy ↦ h _ _ fun _ hs ↦
    ⟨fun xs ↦ hxy _ hs xs, not_imp_not.mp fun xs ↦ hxy _ hs.compl xs⟩⟩⟩


