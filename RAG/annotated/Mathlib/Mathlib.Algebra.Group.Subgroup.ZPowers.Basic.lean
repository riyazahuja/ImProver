lemma AddSubgroup.zmultiples_one_eq_top : zmultiples (1 : ℤ) = ⊤ := by
  /-
    ⊢ Eq (AddSubgroup.zmultiples 1) Top.top
  -/
  rw [zmultiples_eq_closure, closure_singleton_int_one_eq_top]
