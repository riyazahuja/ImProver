    G : Type u_1
    inst✝ : Group G
    x : G
    y : Additive G
    ⊢ Iff (Membership.mem (Set.image ⇑Additive.ofMul ↑(Subgroup.zpowers x)) y) (Me …
  -/
  constructor
    /-
      case h.mp
      G : Type u_1
      inst✝ : Group G
      x : G
      y : Additive G
      ⊢ Membership.mem (Set.image ⇑Additive.ofMul ↑(Subgroup.zpowers x)) y → Members …
    -/
  · rintro ⟨z, ⟨m, hm⟩, hz2⟩
    /-
      case h.mp.intro.intro.intro
      G : Type u_1
      inst✝ : Group G
      x : G
      y : Additive G
      z : G
      hz2 : Eq (Additive.ofMul z) y
      m : Int
      hm : Eq ((fun x_1 => HPow.hPow x x_1) m) z
      ⊢ Membership.mem (↑(AddSubgroup.zmultiples (Additive.ofMul x))) y
    -/
    use m
    /-
      case h
      G : Type u_1
      inst✝ : Group G
      x : G
      y : Additive G
      z : G
      hz2 : Eq (Additive.ofMul z) y
      m : Int
      hm : Eq ((fun x_1 => HPow.hPow x x_1) m) z
      ⊢ Eq ((fun x_1 => HSMul.hSMul x_1 (Additive.ofMul x)) m) y
    -/
    simp only at *
    /-
      case h
      G : Type u_1
      inst✝ : Group G
      x : G
      y : Additive G
