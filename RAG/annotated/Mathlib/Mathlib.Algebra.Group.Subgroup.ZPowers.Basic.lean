    -/
  · rintro ⟨n, hn⟩
    /-
      case h.mpr.intro
      G : Type u_1
      inst✝ : Group G
      x : G
      y : Additive G
      n : Int
      hn : Eq ((fun x_1 => HSMul.hSMul x_1 (Additive.ofMul x)) n) y
      ⊢ Membership.mem (Set.image ⇑Additive.ofMul ↑(Subgroup.zpowers x)) y
    -/
    refine ⟨x ^ n, ⟨n, rfl⟩, ?_⟩
    /-
      case h.mpr.intro
      G : Type u_1
      inst✝ : Group G
      x : G
