/-- The congruence relation generated by a normal subgroup. -/
@[to_additive "The additive congruence relation generated by a normal additive subgroup."]
protected def con : Con G where
  toSetoid := leftRel N
  mul' := fun {a b c d} hab hcd => by
    /-
      G : Type u
      inst✝² : Group G
      N : Subgroup G
      nN : N.Normal
      H : Type v
      inst✝¹ : Group H
      M : Type x
      inst✝ : Monoid M
      a b c d : G
      hab : (QuotientGroup.leftRel N) a b
      hcd : (QuotientGroup.leftRel N) c d
      ⊢ (QuotientGroup.leftRel N) (HMul.hMul a c) (HMul.hMul b d)
    -/
    rw [leftRel_eq] at hab hcd ⊢
    /-
      G : Type u
      inst✝² : Group G
      N : Subgroup G
      nN : N.Normal
      H : Type v
      inst✝¹ : Group H
      M : Type x
      inst✝ : Monoid M
      a b c d : G
      hab : Membership.mem N (HMul.hMul (Inv.inv a) b)
      hcd : Membership.mem N (HMul.hMul (Inv.inv c) d)
      ⊢ (fun x y => Membership.mem N (HMul.hMul (Inv.inv x) y)) (HMul.hMul a c) (HMu …
    -/
    dsimp only
    calc
      c⁻¹ * (a⁻¹ * b) * c⁻¹⁻¹ * (c⁻¹ * d) ∈ N := N.mul_mem (nN.conj_mem _ hab _) hcd
      _ = (a * c)⁻¹ * (b * d) := by
        simp only [mul_inv_rev, mul_assoc, inv_mul_cancel_left]


@[to_additive]
instance Quotient.group : Group (G ⧸ N) :=
  (QuotientGroup.con N).group


/-- The group homomorphism from `G` to `G/N`. -/
