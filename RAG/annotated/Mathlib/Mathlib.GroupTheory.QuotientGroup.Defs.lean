    lift N φ HN (Quot.mk _ g : Q) = φ g :=
  rfl


/-- A group homomorphism `f : G →* H` induces a map `G/N →* H/M` if `N ⊆ f⁻¹(M)`. -/
@[to_additive
      "An `AddGroup` homomorphism `f : G →+ H` induces a map `G/N →+ H/M` if `N ⊆ f⁻¹(M)`."]
def map (M : Subgroup H) [M.Normal] (f : G →* H) (h : N ≤ M.comap f) : G ⧸ N →* H ⧸ M := by
  /-
    G : Type u
    inst✝³ : Group G
    N : Subgroup G
    nN : N.Normal
    H : Type v
    inst✝² : Group H
    M✝ : Type x
    inst✝¹ : Monoid M✝
    M : Subgroup H
    inst✝ : M.Normal
    f : MonoidHom G H
    h : LE.le N (Subgroup.comap f M)
    ⊢ MonoidHom (HasQuotient.Quotient G N) (HasQuotient.Quotient H M)
  -/
  refine QuotientGroup.lift N ((mk' M).comp f) ?_
  /-
    G : Type u
    inst✝³ : Group G
    N : Subgroup G
    nN : N.Normal
    H : Type v
    inst✝² : Group H
    M✝ : Type x
    inst✝¹ : Monoid M✝
    M : Subgroup H
    inst✝ : M.Normal
    f : MonoidHom G H
    h : LE.le N (Subgroup.comap f M)
    ⊢ LE.le N ((QuotientGroup.mk' M).comp f).ker
  -/
  intro x hx
  /-
    G : Type u
    inst✝³ : Group G
    N : Subgroup G
    nN : N.Normal
    H : Type v
    inst✝² : Group H
    M✝ : Type x
    inst✝¹ : Monoid M✝
    M : Subgroup H
    inst✝ : M.Normal
    f : MonoidHom G H
    h : LE.le N (Subgroup.comap f M)
    x : G
    hx : Membership.mem N x
    ⊢ Membership.mem ((QuotientGroup.mk' M).comp f).ker x
  -/
  refine QuotientGroup.eq.2 ?_
  /-
    G : Type u
    inst✝³ : Group G
    N : Subgroup G
    nN : N.Normal
    H : Type v
    inst✝² : Group H
    M✝ : Type x
    inst✝¹ : Monoid M✝
    M : Subgroup H
    inst✝ : M.Normal
    f : MonoidHom G H
    h : LE.le N (Subgroup.comap f M)
    x : G
    hx : Membership.mem N x
    ⊢ Membership.mem M (HMul.hMul (Inv.inv (f x)) 1)
  -/
  rw [mul_one, Subgroup.inv_mem_iff]
  /-
    G : Type u
    inst✝³ : Group G
    N : Subgroup G
    nN : N.Normal
    H : Type v
    inst✝² : Group H
    M✝ : Type x
    inst✝¹ : Monoid M✝
    M : Subgroup H
    inst✝ : M.Normal
    f : MonoidHom G H
    h : LE.le N (Subgroup.comap f M)
    x : G
    hx : Membership.mem N x
    ⊢ Membership.mem M (f x)
  -/
  exact h hx
  /-
    🎉 no goals
  -/


