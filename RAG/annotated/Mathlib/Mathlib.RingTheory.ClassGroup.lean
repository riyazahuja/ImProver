  elems := {1}
  complete := by
    /-
      R : Type u_1
      K : Type u_2
      inst✝⁵ : CommRing R
      inst✝⁴ : Field K
      inst✝³ : Algebra R K
      inst✝² : IsFractionRing R K
      inst✝¹ : IsDomain R
      inst✝ : IsPrincipalIdealRing R
      ⊢ ∀ (x : ClassGroup R), Membership.mem (Singleton.singleton 1) x
    -/
    refine ClassGroup.induction (R := R) (FractionRing R) (fun I => ?_)
    /-
      R : Type u_1
      K : Type u_2
      inst✝⁵ : CommRing R
      inst✝⁴ : Field K
      inst✝³ : Algebra R K
      inst✝² : IsFractionRing R K
      inst✝¹ : IsDomain R
      inst✝ : IsPrincipalIdealRing R
      I : Units (FractionalIdeal (nonZeroDivisors R) (FractionRing R))
      ⊢ Membership.mem (Singleton.singleton 1) (ClassGroup.mk I)
    -/
    rw [Finset.mem_singleton]
    /-
      R : Type u_1
      K : Type u_2
      inst✝⁵ : CommRing R
      inst✝⁴ : Field K
      inst✝³ : Algebra R K
      inst✝² : IsFractionRing R K
      inst✝¹ : IsDomain R
      inst✝ : IsPrincipalIdealRing R
      I : Units (FractionalIdeal (nonZeroDivisors R) (FractionRing R))
      ⊢ Eq (ClassGroup.mk I) 1
    -/
    exact ClassGroup.mk_eq_one_iff.mpr (I : FractionalIdeal R⁰ (FractionRing R)).isPrincipal
    /-
      🎉 no goals
    -/


