      this : Eq Filter.atTop (Filter.generate (Set.image Set.Ici (Set.range a)))
      ⊢ (Filter.generate (Set.image Set.Ici (Set.range a))).IsCountablyGenerated
    -/
    exact ⟨_, (countable_range _).image _, rfl⟩
    /-
      🎉 no goals
