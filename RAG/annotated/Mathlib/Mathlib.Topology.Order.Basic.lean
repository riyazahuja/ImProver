  by_cases h : ∃ (x : α), IsTop x
    /-
      case pos
      α : Type u
      β : Type v
      γ : Type w
      inst✝³ : TopologicalSpace α
      inst✝² : LinearOrder α
      inst✝¹ : OrderTopology α
      inst✝ : SecondCountableTopology α
      h : Exists fun x => IsTop x
      ⊢ Filter.atTop.IsCountablyGenerated
    -/
  · rcases h with ⟨x, hx⟩
    /-
      case pos.intro
      α : Type u
      β : Type v
      γ : Type w
      inst✝³ : TopologicalSpace α
      inst✝² : LinearOrder α
      inst✝¹ : OrderTopology α
      inst✝ : SecondCountableTopology α
      x : α
      hx : IsTop x
      ⊢ Filter.atTop.IsCountablyGenerated
    -/
    rw [atTop_eq_pure_of_isTop hx]
    /-
      case pos.intro
      α : Type u
      β : Type v
      γ : Type w
      inst✝³ : TopologicalSpace α
      inst✝² : LinearOrder α
      inst✝¹ : OrderTopology α
      inst✝ : SecondCountableTopology α
      x : α
      hx : IsTop x
      ⊢ (Pure.pure x).IsCountablyGenerated
    -/
    exact isCountablyGenerated_pure x
    /-
      🎉 no goals
    -/
    /-
      case neg
      α : Type u
      β : Type v
      γ : Type w
      inst✝³ : TopologicalSpace α
      inst✝² : LinearOrder α
      inst✝¹ : OrderTopology α
      inst✝ : SecondCountableTopology α
      h : Not (Exists fun x => IsTop x)
      ⊢ Filter.atTop.IsCountablyGenerated
    -/
  · rcases exists_countable_basis α with ⟨b, b_count, b_ne, hb⟩
    /-
      case neg.intro.intro.intro
      α : Type u
      β : Type v
      γ : Type w
      inst✝³ : TopologicalSpace α
      inst✝² : LinearOrder α
      inst✝¹ : OrderTopology α
      inst✝ : SecondCountableTopology α
      h : Not (Exists fun x => IsTop x)
      b : Set (Set α)
      b_count : b.Countable
      b_ne : Not (Membership.mem b EmptyCollection.emptyCollection)
      hb : TopologicalSpace.IsTopologicalBasis b
      ⊢ Filter.atTop.IsCountablyGenerated
    -/
    have : Countable b := by exact Iff.mpr countable_coe_iff b_count
    have A : ∀ (s : b), ∃ (x : α), x ∈ (s : Set α) := by
      intro s
      have : (s : Set α) ≠ ∅ := by
        intro H
        apply b_ne
        convert s.2
        exact H.symm
      exact Iff.mp nmem_singleton_empty this
    /-
      case neg.intro.intro.intro
      α : Type u
      β : Type v
      γ : Type w
      inst✝³ : TopologicalSpace α
      inst✝² : LinearOrder α
      inst✝¹ : OrderTopology α
      inst✝ : SecondCountableTopology α
      h : Not (Exists fun x => IsTop x)
      b : Set (Set α)
      b_count : b.Countable
      b_ne : Not (Membership.mem b EmptyCollection.emptyCollection)
      hb : TopologicalSpace.IsTopologicalBasis b
      this : Countable ↑b
      A : ∀ (s : ↑b), Exists fun x => Membership.mem (↑s) x
      ⊢ Filter.atTop.IsCountablyGenerated
    -/
