instance {α β : Type*} [UniformSpace β] [CompleteSpace β] : CompleteSpace (α →ᵤ β) :=
  (UniformOnFun.uniformEquivUniformFun β {univ} (mem_singleton _)).completeSpace_iff.1 inferInstance


/-- Composing on the left by a uniformly continuous function preserves uniform convergence -/
theorem UniformContinuousOn.comp_tendstoUniformly (s : Set β) (F : ι → α → β) (f : α → β)
    (hF : ∀ i x, F i x ∈ s) (hf : ∀ x, f x ∈ s)
    {g : β → γ} (hg : UniformContinuousOn g s) (h : TendstoUniformly F f p) :
    TendstoUniformly (fun i x => g (F i x)) (fun x => g (f x)) p := by
  /-
    α : Type u_1
    β : Type u_2
    γ : Type u_3
    ι : Type u_4
    inst✝¹ : UniformSpace β
    inst✝ : UniformSpace γ
    p : Filter ι
    s : Set β
    F : ι → α → β
    f : α → β
    hF : ∀ (i : ι) (x : α), Membership.mem s (F i x)
    hf : ∀ (x : α), Membership.mem s (f x)
    g : β → γ
    hg : UniformContinuousOn g s
    h : TendstoUniformly F f p
    ⊢ TendstoUniformly (fun i x => g (F i x)) (fun x => g (f x)) p
  -/
  rw [uniformContinuousOn_iff_restrict] at hg
  /-
    α : Type u_1
    β : Type u_2
    γ : Type u_3
    ι : Type u_4
    inst✝¹ : UniformSpace β
    inst✝ : UniformSpace γ
    p : Filter ι
    s : Set β
    F : ι → α → β
    f : α → β
    hF : ∀ (i : ι) (x : α), Membership.mem s (F i x)
    hf : ∀ (x : α), Membership.mem s (f x)
    g : β → γ
    hg : UniformContinuous (s.restrict g)
    h : TendstoUniformly F f p
    ⊢ TendstoUniformly (fun i x => g (F i x)) (fun x => g (f x)) p
  -/
  lift F to ι → α → s using hF with F' hF'
  /-
    case intro
    α : Type u_1
    β : Type u_2
    γ : Type u_3
    ι : Type u_4
    inst✝¹ : UniformSpace β
    inst✝ : UniformSpace γ
    p : Filter ι
    s : Set β
    F : ι → α → β
    f : α → β
    hf : ∀ (x : α), Membership.mem s (f x)
    g : β → γ
    hg : UniformContinuous (s.restrict g)
    F' : ι → α → ↑s
    hF' : Eq (fun i i_1 => ↑(F' i i_1)) F
    h✝ h : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) f p
    ⊢ TendstoUniformly (fun i x => g ↑(F' i x)) (fun x => g (f x)) p
  -/
  lift f to α → s using hf with f' hf'
  /-
    case intro.intro
    α : Type u_1
    β : Type u_2
    γ : Type u_3
    ι : Type u_4
    inst✝¹ : UniformSpace β
    inst✝ : UniformSpace γ
    p : Filter ι
    s : Set β
    F : ι → α → β
    f : α → β
    g : β → γ
    hg : UniformContinuous (s.restrict g)
    F' : ι → α → ↑s
    hF' : Eq (fun i i_1 => ↑(F' i i_1)) F
    h✝¹ : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) f p
    f' : α → ↑s
    hf' : Eq (fun i => ↑(f' i)) f
    h✝ h : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) (fun i => ↑(f' i)) p
    ⊢ TendstoUniformly (fun i x => g ↑(F' i x)) (fun x => g ↑(f' x)) p
  -/
  rw [tendstoUniformly_iff_tendsto] at h
  have : Tendsto (fun q : ι × α ↦ (f' q.2, (F' q.1 q.2))) (p ×ˢ ⊤) (𝓤 s) :=
    h.of_tendsto_comp isUniformEmbedding_subtype_val.comap_uniformity.le
  /-
    case intro.intro
    α : Type u_1
    β : Type u_2
    γ : Type u_3
    ι : Type u_4
    inst✝¹ : UniformSpace β
    inst✝ : UniformSpace γ
    p : Filter ι
    s : Set β
    F : ι → α → β
    f : α → β
    g : β → γ
    hg : UniformContinuous (s.restrict g)
    F' : ι → α → ↑s
    hF' : Eq (fun i i_1 => ↑(F' i i_1)) F
    h✝¹ : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) f p
    f' : α → ↑s
    hf' : Eq (fun i => ↑(f' i)) f
    h✝ : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) (fun i => ↑(f' i)) p
    h : Filter.Tendsto (fun q => { fst := ↑(f' q.2), snd := ↑(F' q.1 q.2) }) (SPro …
    this : Filter.Tendsto (fun q => { fst := f' q.2, snd := F' q.1 q.2 }) (SProd.s …
    ⊢ TendstoUniformly (fun i x => g ↑(F' i x)) (fun x => g ↑(f' x)) p
  -/
  apply UniformContinuous.comp_tendstoUniformly hg ?_
  /-
    α : Type u_1
    β : Type u_2
    γ : Type u_3
    ι : Type u_4
    inst✝¹ : UniformSpace β
    inst✝ : UniformSpace γ
    p : Filter ι
    s : Set β
    F : ι → α → β
    f : α → β
    g : β → γ
    hg : UniformContinuous (s.restrict g)
    F' : ι → α → ↑s
    hF' : Eq (fun i i_1 => ↑(F' i i_1)) F
    h✝¹ : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) f p
    f' : α → ↑s
    hf' : Eq (fun i => ↑(f' i)) f
    h✝ : TendstoUniformly (fun i i_1 => ↑(F' i i_1)) (fun i => ↑(f' i)) p
    h : Filter.Tendsto (fun q => { fst := ↑(f' q.2), snd := ↑(F' q.1 q.2) }) (SPro …
    this : Filter.Tendsto (fun q => { fst := f' q.2, snd := F' q.1 q.2 }) (SProd.s …
    ⊢ TendstoUniformly F' f' p
  -/
  rwa [← tendstoUniformly_iff_tendsto] at this
  /-
    🎉 no goals
  -/


theorem UniformContinuousOn.comp_tendstoUniformly_eventually (s : Set β) (F : ι → α → β) (f : α → β)
    (hF : ∀ᶠ i in p, ∀ x, F i x ∈ s) (hf : ∀ x, f x ∈ s)
    {g : β → γ} (hg : UniformContinuousOn g s) (h : TendstoUniformly F f p) :
    TendstoUniformly (fun i => fun x => g (F i x)) (fun x => g (f x)) p := by
  classical
  rw [eventually_iff_exists_mem] at hF
  obtain ⟨s', hs', hs⟩ := hF
  let F' : ι → α → β := fun (i : ι) x => if i ∈ s' then F i x else f x
  have hF : F =ᶠ[p] F' :=  by
    rw [eventuallyEq_iff_exists_mem]
    refine ⟨s', hs', fun y hy => by aesop⟩
  have h' : TendstoUniformly F' f p := by
    rwa [tendstoUniformly_congr hF] at h
  apply (tendstoUniformly_congr _).mpr
    (UniformContinuousOn.comp_tendstoUniformly s F' f (by aesop) hf hg h')
  rw [eventuallyEq_iff_exists_mem]
  refine ⟨s', hs', fun i hi => by aesop⟩


