theorem t5 (f : ℕ → ℝ × ℝ) (x₀ y₀ : ℝ) :
    Tendsto f atTop (␀␀ (x₀, y₀)) ↔
      Tendsto (Prod.fst ∘ f) atTop (␀␀ x₀) ∧ Tendsto (Prod.snd ∘ f) atTop (␀␀ y₀) :=
  calc
    Tendsto f atTop (␀␀ (x₀, y₀)) ↔ map f atTop ≤ ␀␀ (x₀, y₀) := Iff.rfl
    _ ↔ map f atTop ≤ ␀␀ x₀ ×ˢ ␀␀ y₀ := by rw [nhds_prod_eq]
    _ ↔ map f atTop ≤ comap Prod.fst (␀␀ x₀) ⊓ comap Prod.snd (␀␀ y₀) := Iff.rfl
    _ ↔ map f atTop ≤ comap Prod.fst (␀␀ x₀) ∧ map f atTop ≤ comap Prod.snd (␀␀ y₀) := le_inf_iff
    _ ↔ map Prod.fst (map f atTop) ≤ ␀␀ x₀ ∧ map Prod.snd (map f atTop) ≤ ␀␀ y₀ := by
      rw [← map_le_iff_le_comap, ← map_le_iff_le_comap]
    _ ↔ map (Prod.fst ∘ f) atTop ≤ ␀␀ x₀ ∧ map (Prod.snd ∘ f) atTop ≤ ␀␀ y₀ := by
      rw [map_map, map_map]

