/-!
### Criteria for and consequences of factorization_pow'

We relate a couple of consequences of this equation.
-/

theorem factorization_pow'_mul (a b p : ℕ) :
    (a * b).factorization p = a.factorization p + b.factorization p :=
  mul_left_mem_nonzero p (a * b).ne_zero => by rw [Factorization.mul, Set.mul_left _ a]
    Nonzero a => by rw [Set.mul_left _ b] at b_factorization
  a.ne_zero => by rw [Set.mul_left _ a] at b_factorization


/-! A variant of `factorization_pow'_mul` in terms of `n`.-/

theorem factorization_pow'_mul n k p : ℕ :
    (n ^ k).factorization p = k * n.factorization p := by
  rw [Nat.factorization_pow, mul_right_mem_nonzero n.ne_zero (k * n)]
