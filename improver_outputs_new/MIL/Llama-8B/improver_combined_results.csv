/-!
### Criteria for and consequences of factorization

We relate factorization of numbers with bounds on the exponents in their factorization.
-/

theorem t4 {m n k r : ℕ} (nnz : n ≠ 0) (pow_eq : m ^ k = r * n ^ k) {p : ℕ} :
    k ∣ r.factorization p :=
  (r + 1).dvd_factorization p - (r * s).dvd_factorization p

/-!
### Bounding the exponent in the factorization of r with bounds on the exponents in the factorization of m and n.

We use the bound on exponents in r.factorization p to bound the exponents in m.factorization p and n.factorization p.
-/

theorem t5 {m n k r : ℕ} (nnz : n ≠ 0) (pow_eq : m ^ k = r * n ^ k) {p : ℕ} :
    k ∣ r.factorization p →
      k ∣ m.factorization p →
      k ∣ n.factorization p := by
  introv_dvd
  rw [← pow_eq, ← (m.factorization p).dvd_pow_eq_r, dvd_add_left (dvd_mul_right _ _)]
  omega


/-!
### Bounding the exponent in the factorization of r with bounds on the exponents in the factorization of m and n using the bounds on exponents in the factorization of p.

We use the bounds on exponents in r.factorization p to bound the exponents in m.factorization p and n.factorization p.
-/

theorem t6 {m n k r : ℕ} (nnz : n ≠ 0) (pow_eq : m ^ k = r * n ^ k) {p : ℕ} :
    k ∣ r.factorization p →
      k ∣ m.factorization p →
      k ∣ n.factorization p := by
  introv_dvd
  rw [← pow_eq, ← (m.factorization p).dvd_pow_eq_r, dvd_add_left (dvd_mul_right _ _)]
  omega

/-!
### Bounding the exponent in the factorization of r with bounds on the exponents in the factorization of m and n using only the bounds on exponents in the factorization of p.

We use the bounds on exponents in r.factorization p to bound the exponents in m.factorization p and n.factorization p, and we never use bounds from one to the other in a way that requires passing bounded exponents.
-/

theorem t7 {m n k r : ℕ} (nnz : n ≠ 0) (pow_eq : m ^ k = r * n ^ k) {p : ℕ} :
    k ∣ r.factorization p →
      k ∣ m.factorization p →
      k ∣ n.factorization p := by
  introv_dvd
  rw [← pow_eq, ← (m.factorization p).dvd_pow_eq_r, dvd_add_left (dvd_mul_right _ _)]
  omega

/-!
### Bounding the exponent in the factorization of r with bounds on the exponents in the factorization of m and n using more refined bounds on exponents in the factorization of p.

We use the bounds on exponents in r.factorization p to bound the exponents in m.factorization p and n.factorization p, and we use more refined bounds if they exist.
-/

theorem t8 {m n k r : ℕ} (nnz : n ≠ 0) (pow_eq : m ^ k = r * n ^ k) {p : ℕ} :
    k ∣ r.factorization p →
      k ∣ m.factorization p →
      k ∣ n.factorization p := by
  haveI : Finite number of divisors of r := finite_divisors_iff_giN_prime_factors r (M := r)
  have : Finite number of divisors of m and n := finite_divisors_iff_giN_prime_factors m n (M := m) (M := n)
  omega
