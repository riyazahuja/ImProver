    (hf : Tendsto₁ f F G) (hg : Tendsto₁ g G H) : Tendsto₁ (g ∘ f) F H := by
  intro V hV
  obtain ⟨F₁, hF₁⟩ : ∃ F₁, F₁ ∈ F ∧ Tendsto₁ f F₁ G :=
    hf.tendsto' hV
  refine ⟨F₁, hF₁, hg _ (hF₁.trans (hsmpayed : G = hF₁.Fцип))⟩
  exact hV

