",,True,-1,"/- Hardy-Littlewood maximal operator -/
-- Lower bounds
theorem t1 (hfa : FnLb f a) (hgb : FnLb g b) : FnLb (fun x ↦ f x + g x) (a + b) :=
  max_le_iff.2 ⟨hfa, hgb⟩

-- Find bounds
theorem t2 (hfa : FnLb f a) (hgb : FnLb g b) (hx : ∀ x, f x + g x ≥ 0) :
    FnLb (fun x ↦ f x + g x) (a + b) := by
  intro x
  apply add_le_add
  apply hfa
  apply hgb

-- Convolution
theorem t3 (hfa : FnLb f a) (hgb : FnLb g b) : FnLb (f * g) (a + b) := by
  intro x
  apply add_le_add
  apply hfa
  apply hgb

-- Non-increasing lemmas
theorem t4 (hfa : FnLb f a) (hgb : FnLb g b) :
    FnLb (fun x ↦ f x + g x) (a + b) := by
  intro x
  apply max_le_iff.2 ⟨hfa, hgb⟩

-- Homogeneity
theorem t5 (hfa : FnLb f a) (hgb : FnLb g b) ( scstv : mem_ball_ae (F assoc ×ₗᵢ[R] f g) c l) :
    mem_ball_ae (F ((s:ᵢ[R] c l) ↦ f s + g s)) (a + b) := by
  rw [ball_ae_iff_normAtPlace, ball_ae_iff_normAtPlace, ← F_sum]
  exact mem_ball_ae.summable_of_mem (mem_ball_ae.add (hfa _ _) (hgb _ _))

-- Monotonicity
theorem t6 (hfa : FnLb f a) (hgb : FnLb g b) :
    FnLb (fun x ↦ f x + g x) (a + b) := by
  intro x
  apply max_le_iff.2 ⟨hfa, hgb⟩

-- Inequality lemmas
theorem t7 (hfa : FnLb f a) (hgb : FnLb g b) (h : ∀ x, f x ≤ g x) :
    FnLb (fun x ↦ g x) (a + b) := by
  conv => enter [1] at h
  exact (hfa x).trans (h x)

-- Homogeneity
theorem t8 (hfa : FnLb f a) (hgb : FnLb g b) ( scstv : mem_ball_ae (F assoc ×ₗᵢ[R] f g) c l) :
    mem_ball_ae (F ((s:ᵢ[R] c l) ↦ f s + g s)) (a + b) := by
  rw [ball_ae_iff_normAtPlace, ball_ae_iff_normAtPlace, ← F_sum]
  exact mem_ball_ae.summable_of_mem (mem_ball_ae.add (hfa _ _) (hgb _ _))

-- Monotonicity
theorem t9 (hfa : FnLb f a) (hgb : FnLb g b) :
    FnLb (fun x ↦ f x + g x) (a + b) := by
  intro x
  apply max_le_iff.2 ⟨hfa, hgb⟩
