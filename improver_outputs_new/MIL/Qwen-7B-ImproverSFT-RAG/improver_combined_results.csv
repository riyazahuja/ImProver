  Set.ext fun _ => le_pred_iff_of_not_isMin ha
theorem Icc_subset_Ioc_pred_left_of_not_isMin (ha : ¬IsMin a) : Icc a b ⊆ Ioc (pred a) b := by
 rw [← Ioi_inter_Iic, ← Ici_inter_Iic]
 gcongr
 apply Ici_subset_Ioi_pred_of_not_isMin ha

