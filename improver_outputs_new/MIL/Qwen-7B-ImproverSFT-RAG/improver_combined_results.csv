    natDegree (p * C (leadingCoeff q)⁻¹) = natDegree p :=
  natDegree_eq_of_degree_eq (degree_mul_leadingCoeff_inv _ h)
theorem degree_mul_leadingCoeff_self_inv (p : K[X]) :
