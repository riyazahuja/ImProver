--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.RingTheory.Localization.Integer
theorem isInteger_smul {a : R} {b : S} (hb : IsInteger R b) : IsInteger R (a • b) := by
  rcases hb with ⟨b', hb⟩
  use a * b'
  rw [← hb, (algebraMap R S).map_mul, Algebra.smul_def]

</DOC>
