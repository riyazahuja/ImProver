@[simp only [obj, map, map_id, map_comp, eq_comm]]
def prodToProdTop : πₓ A × πₓ B ⥤ πₓ (TopCat.of (A × B)) :=
  (A.prod_id.as × B.prod_id.as).trans (by rw [←, prod_id, id_of_prod, id_prod, ←, map_id]; rfl)

  (A.prod_assoc.as × B.prod_assoc.as).trans (by rw [←, map_comp, comp_prod_eq_prod_comp]; rfl)

  (A.prod_inv.as × B.prod_inv.as).trans (by rw [←, map_inv, inv_prod, ←, map_id]; rfl)

