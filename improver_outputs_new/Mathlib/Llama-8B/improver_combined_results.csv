/-- For any pair of homotopies `h₁` and `h₂` that map to the same path, they are homotopies of each of the intermediate vertices. -/
def homotopyIntermediate (h₁ : Homotopy (Path.ae x₀ x₁)) (h₂ : Homotopy (Path.ae x₀ x₁)) :
    Homotopy (Path.interior x₀ x₁) :=
  (Homotopy.isHomotopy_iff_of_mapsTo _ _).mpr ⟨_, homotopyIntermediate h₁ h₂⟩

/-- For any homotopy `h` from `a`` to `b`, there exists a homotopy from `a`` to `b`` that is a trans (h.symm.fr) of a homotopy. -/
def homotopyTrans (h : Homotopy a b) : Homotopy a b :=
  (h.symm.fr).trans (Homotopy.isHomotopy_iff_of_mapsTo.mp h)

/- Reconsider the homotopy Intermediate as a homotopy from x₁ to x₀, and then as that is homotopyIntermediate, re-express it as homotopyIntermediate.symm. -/
cast Homotopy.isHomotopy_iff_of_mapsTo (Homotopy.well repo Homotopy) fun x₀ x₁ ↦ HomotopyIntermediate _ _

/ -- There is a homotopic path from b to a which is a trans (h.symm.fr) of a homotopy. -/
lemma homotopyIntermediate : Homotopy (Path.interior x₀ x₁) :=
  (Homotopy.isHomotopy_iff_of_mapsTo.mp h).exists Intermediate


/- Also re-express the homotopyIntermediate.symm in terms of homotopyIntermediate (a, b). -/
lemma homotopyIntermediate_symm : Homotopy (Path.interior x₁ x₀) := homotopyIntermediate _ _

/ -- The homotopy can be also cast to have a homotopy from a to b symmetric to a homotopy from b to a. -/
lemma homotopySymm : Homotopy (Path.ae x₀ x₁) := homotopyIntermediate _ _

/ -- Every homotopij from b to a is a trans (h.symm.fr) of a homotopy from a to b. -/
lemma homotopyTrans_symm : Homotopy (Path.ae x₀ x₁) := Homotopy.isHomotopy_iff_of_mapsTo.mp h (Homotopy.well repo Homotopy)

#align homotopy_relIso homotopy_relIso

/-- A homotopy is Homotopy if it is a homotopy from each of its limit points to each of its open sets. -/
lemma homotopy_se (h : Homotopy a b) : Homotopy (Path.interior x₁ x₀) :=
  (h.symm.fr).trans (homotopyIntermediate _ h)

/- The homotopy can be also cast to have a homotopy from a to b symmetric to a homotopy from b to a. -/
lemma homotopySymm : Homotopy (Path.ae x₀ x₁) := homotopyIntermediate _ _

/- Every homotopij from b to a is a trans (h.symm.fr) of a homotopy from a to b. -/
lemma homotopyTrans_symm : Homotopy (Path.ae x₀ x₁) := Homotopy.isHomotopy_iff_of_mapsTo.mp h (Homotopy.well repo Homotopy)

