/-!
### Criteria for and consequences of homotopic equality
-/

/-- If `f` and `g` are homotopic following paths `p` and `q`, then they are homotopic in the space
of all homotopic paths. -/
theorem homotopic_imp_self_and : Homotopic.map h where l_injective f g => Iff.trans
    (h _ _) (h _ _)) : Homotopic.map h where l_injective f g :=
  .of_eq <| by simp [← homotopic_eq_hash, map_ι]; rfl


