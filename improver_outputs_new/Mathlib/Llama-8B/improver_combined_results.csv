The map taking the product of two fundamental groupoids to the fundamental groupoid of the product
of the two topological spaces. This is in fact an isomorphism (see `prodIso`).
-/
@[simps obj]
def prodToProdTop : πₓ A × πₓ B ⥤ πₓ (TopCat.of (A × B)) where
  obj g := ⟨g.fst.as, g.snd.as⟩
  map {x y} p :=
    match x, y, p with
    | (@ProdIso.id A).id ℕ, ↦ id.prodIso
    | (@ProdIso.id B).id ℕ, ↦ id.prodIso
  map_id := by
    rintro ⟨x₀, x₁⟩
    apply @ProdIso.id A.mprodIso x₀ x₁
  map_comp {x y z} f g :=
    match x, y, z, f, g with
    | @ProdIso.id A, @ProdIso.id B, @ProdIso.id C, f, g, h =>
      (ProdIso.id A).id.prodIso (ProdIso.id B).id.prodIso (ProdIso.id C).id.prodIso
      f f₀ f₁ g g₀ g₁ h h₀ h₁
      (h.def ToProdIso.id)

