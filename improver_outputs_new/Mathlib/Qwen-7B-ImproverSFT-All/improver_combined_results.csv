--name=one_ne_zero
--context_item_type=theorem
@[simp] lemma one_ne_zero [One α] [NeZero (1 : α)] : (1 : α) ≠ 0 := NeZero.ne (1 : α)
</ITEM>
<ITEM>
--name=not_false_iff
--context_item_type=theorem
theorem not_false_iff : (¬False) ↔ True := iff_true_intro not_false
</ITEM>
<ITEM>
--name=Ne
--context_item_type=def
/--
`a ≠ b`, or `Ne a b` is defined as `¬ (a = b)` or `a = b → False`,
and asserts that `a` and `b` are not equal.
-/
@[reducible] def Ne {α : Sort u} (a b : α) :=
  ¬(a = b)
</ITEM>
<ITEM>
--name=Function.comp_apply
--context_item_type=theorem
@[simp] theorem Function.comp_apply {f : β → δ} {g : α → β} {x : α} : comp f g x = f (g x) := rfl
</ITEM>
<ITEM>
--name=not_le
--context_item_type=theorem
@[simp] lemma not_le : ¬a ≤ b ↔ b < a := (lt_iff_not_ge _ _).symm
</ITEM>
<ITEM>
--name=mul_inv_cancel_left₀
--context_item_type=theorem
@[simp]
theorem mul_inv_cancel_left₀ (h : a ≠ 0) (b : G₀) : a * (a⁻¹ * b) = b :=
  calc
    a * (a⁻¹ * b) = a * a⁻¹ * b := (mul_assoc _ _ _).symm
    _ = b := by simp [h]
</ITEM>
<ITEM>
--name=Path.trans_apply
--context_item_type=theorem
theorem trans_apply (γ : Path x y) (γ' : Path y z) (t : I) :
    (γ.trans γ') t =
      if h : (t : ℝ) ≤ 1 / 2 then γ ⟨2 * t, (mul_pos_mem_iff zero_lt_two).2 ⟨t.2.1, h⟩⟩
      else γ' ⟨2 * t - 1, two_mul_sub_one_mem_iff.2 ⟨(not_le.1 h).le, t.2.2⟩⟩ :=
  show ite _ _ _ = _ by split_ifs <;> rw [extend_extends]
</ITEM>
<ITEM>
--name=Subtype.ext
--context_item_type=theorem
@[ext]
</ITEM>
<ITEM>
--name=trans
--context_item_type=theorem
lemma trans [IsTrans α r] : a ≺ b → b ≺ c → a ≺ c := IsTrans.trans _ _ _
