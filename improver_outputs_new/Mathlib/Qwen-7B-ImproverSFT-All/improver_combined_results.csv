--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.Algebra.Category.Ring.Basic
lemma coe_of (R : Type u) [CommSemiring R] : (of R : Type u) = R :=
  rfl
lemma of_carrier (R : CommSemiRingCat.{u}) : of R = R := rfl
variable {R} in
@[ext]
structure Hom (R S : CommSemiRingCat) where
  private mk ::
  hom : R →+* S
instance : Category CommSemiRingCat where
  Hom R S := Hom R S
  id R := ⟨RingHom.id R⟩
  comp f g := ⟨g.hom.comp f.hom⟩
instance {R S : CommSemiRingCat.{u}} : CoeFun (R ⟶ S) (fun _ ↦ R → S) where
  coe f := f.hom
@[simp]
lemma hom_id {R : CommSemiRingCat} : (𝟙 R : R ⟶ R).hom = RingHom.id R := rfl

</DOC>
<DOC>

--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.Algebra.Homology.HomologicalComplex
theorem mkHom_f_succ_succ (n : ℕ) :
    (mkHom P Q zero one one_zero_comm succ).f (n + 2) =
      (succ n
          ⟨(mkHom P Q zero one one_zero_comm succ).f n,
            (mkHom P Q zero one one_zero_comm succ).f (n + 1),
            (mkHom P Q zero one one_zero_comm succ).comm (n + 1) n⟩).1 := by
  dsimp [mkHom, mkHomAux]

</DOC>
