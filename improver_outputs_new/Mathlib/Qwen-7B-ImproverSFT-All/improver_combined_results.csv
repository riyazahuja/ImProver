--name=mul_ite
--context_item_type=theorem
@[to_additive]
lemma mul_ite (a b c : α) : (a * if P then b else c) = if P then a * b else a * c := mul_dite ..
</ITEM>
<ITEM>
--name=one_ne_zero
--context_item_type=theorem
@[simp] lemma one_ne_zero [One α] [NeZero (1 : α)] : (1 : α) ≠ 0 := NeZero.ne (1 : α)
</ITEM>
<ITEM>
--name=not_false_iff
--context_item_type=theorem
theorem not_false_iff : (¬False) ↔ True := iff_true_intro not_false
</ITEM>
<ITEM>
--name=Ne
--context_item_type=def
/--
`a ≠ b`, or `Ne a b` is defined as `¬ (a = b)` or `a = b → False`,
and asserts that `a` and `b` are not equal.
-/
@[reducible] def Ne {α : Sort u} (a b : α) :=
  ¬(a = b)
</ITEM>
