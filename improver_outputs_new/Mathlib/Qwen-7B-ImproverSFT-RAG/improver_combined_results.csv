--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.SetTheory.ZFC.Ordinal
theorem isOrdinal_empty : IsOrdinal ∅ :=
  ⟨isTransitive_empty, fun _ _ H ↦ (not_mem_empty _ H).elim⟩
theorem isOrdinal_not_mem_univ : IsOrdinal ∉ Class.univ.{u} := by
  rintro ⟨x, hx, -⟩
  suffices IsOrdinal x by
    apply Class.mem_irrefl x
    rwa [Class.coe_mem, hx]
  refine ⟨fun y hy z hz ↦ ?_, fun hyz hzw hwx ↦ ?_⟩ <;> rw [← Class.coe_apply, hx] at *
  exacts [hy.mem hz, hwx.mem_trans hyz hzw]

</DOC>
<DOC>

--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.GroupTheory.Coxeter.Inversion
theorem length_mul_left_ne (w : W) : ℓ (w * t) ≠ ℓ w := by
  suffices cs.lengthParity (w * t) ≠ cs.lengthParity w by
    contrapose! this
    simp only [lengthParity_eq_ofAdd_length, this]
  rcases ht with ⟨w, i, rfl⟩
  simp [lengthParity_simple]

</DOC>
<DOC>

--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.Order.Iterate
theorem seq_lt_seq_of_lt_of_le (hf : Monotone f) (n : ℕ) (h₀ : x 0 < y 0)
    (hx : ∀ k < n, x (k + 1) < f (x k)) (hy : ∀ k < n, f (y k) ≤ y (k + 1)) : x n < y n := by
  cases n
  exacts [h₀, hf.seq_pos_lt_seq_of_lt_of_le (Nat.zero_lt_succ _) h₀.le hx hy]

</DOC>
<DOC>

--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.NumberTheory.ArithmeticFunction
theorem id_apply {x : ℕ} : id x = x :=
  rfl
def pow (k : ℕ) : ArithmeticFunction ℕ :=
  id.ppow k
@[simp]
theorem pow_apply {k n : ℕ} : pow k n = if k = 0 ∧ n = 0 then 0 else n ^ k := by
  cases k
  · simp [pow]
  rename_i k  -- Porting note: added
  simp [pow, k.succ_pos.ne']

</DOC>
