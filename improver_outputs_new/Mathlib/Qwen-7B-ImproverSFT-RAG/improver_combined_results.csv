  rfl
lemma of_carrier (R : RingCat.{u}) : of R = R := rfl
variable {R} in
@[ext]
structure Hom (R S : RingCat) where
  private mk ::
  hom : R →+* S
instance : Category RingCat where
  Hom R S := Hom R S
  id R := ⟨RingHom.id R⟩
  comp f g := ⟨g.hom.comp f.hom⟩
instance {R S : RingCat.{u}} : CoeFun (R ⟶ S) (fun _ ↦ R → S) where
  coe f := f.hom
