--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.SetTheory.Game.Nim
noncomputable def nim (o : Ordinal.{u}) : PGame.{u} :=
  ⟨o.toType, o.toType,
    fun x => nim ((enumIsoToType o).symm x).val,
