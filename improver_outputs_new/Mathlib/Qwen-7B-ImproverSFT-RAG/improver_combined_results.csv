theorem rel_iff {H K : Subgroup G} {x y : G} :
    setoid ↑H ↑K x y ↔ ∃ a ∈ H, ∃ b ∈ K, y = a * x * b :=
  Iff.trans
    ⟨fun (hxy : doset x H K = doset y H K) => hxy ▸ mem_doset_self H K y,
      fun hxy => (doset_eq_of_mem hxy).symm⟩ mem_doset

