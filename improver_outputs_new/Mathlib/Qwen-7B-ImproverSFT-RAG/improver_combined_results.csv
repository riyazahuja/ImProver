    whiskerRight := fun {_ _} f _ ↦ Limits.prod.map f (𝟙 _)
    tensorHom := fun f g ↦ Limits.prod.map f g
    tensorUnit := ⊤_ C
    associator := prod.associator
    leftUnitor := fun P ↦ Limits.prod.leftUnitor P
    rightUnitor := fun P ↦ Limits.prod.rightUnitor P
  }
  .ofTensorHom
