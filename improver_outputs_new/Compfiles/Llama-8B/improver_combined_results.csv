",,True,-1,"/ -- There are infinitely many perfect square pairs which can be expressed as a sum of two different elements from a given set.
/  We relate this to a condition on will have something to say on the inifinite sequences of square pairs
/  that are at distance 50 from each other begin to stably exist
/ --/

theorem fun p (B : Finset.Icc n (2 * n)) : 50 ≤ max (p + B) sequence length where
  length (B + p) = length B | 50 ≤ length B := by
  rw [Finset.one_add_div, ← Finset.add_scalar (50 · 1), max_iff] <;>
    apply Finset.length_ideal_le_length <;>
    intro; apply Finset.add_le_add_left
