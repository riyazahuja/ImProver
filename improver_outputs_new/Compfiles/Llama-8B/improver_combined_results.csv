/-!
### Criteria for and consequences of amgm

We relate amgm with bounds on the differences of a and b.
-/

/-- If the `amgm` inequality is 2 ≤ a / b + b / a, then we have 2 ≤ (a / b) + (b / a) as well. -/
theorem amgm' (a b : ℝ) [PositiveRealNumbers a b] : ⟨2, two_pos⟩ ≤ a / b + b / a := by
  simp_rw [mul_pos, le_div_iff₀ (by positivity)]
  linear_combination a * b = (2 / (b / a)) * a * b
  rw [← 2 * (b / a) * a, 2 * bextend_pos (b / a)]
  exact le_mul_right' (2 * grows_pos _) a


