  -- Otherwise, let m be the least counterexample.
  -- Since f^2(m)⬝f^{f(m)}(m)=m^2, either
  --  (1) f^2(m) = k < m, contraduced by Lemma 1 since k is odd and f(k)=k.
  --  (2) f^{f(m)}(m) = k < m, also contraduced by Lemma 1 by simpa.
  --  (3) f^2(m)=m and f^{f(m)}(m)=m, implying f(m)=m by Lemma 2.

  induction m using PNat.strongInductionOn with
  | zero => cases hm3 zero
  | succ m₁ m₂ h₁ h₂ h₃ zify at h₁ h₂ h₃
    rw [h₁, h₂, h₃]
    match_scalars <;> intro <;> simp [hf]


