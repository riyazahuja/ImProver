  have : 0 < a * b * c := mul_pos ha hb hc
  rw [← min_assoc, min_comm]
  exact trans ?_ (le_of_lt (not_le.mp ha.le))
  rw [min_comm, min_assoc, min_comm]
  exact trans ?_ (le_of_lt (not_le.mp hb.le))
  rw [min_comm, min_assoc, min_comm (c * c)]
  exact trans ?_ (le_of_lt (not_le.mp hc.le))
