",,True,-1,"#align imo2021_p1 imo2021_p1

-- Regions and lemmas
lemma imo2021_p1 (n : ℕ) (hn : 100 ≤ n) (A : Set (Finset.Icc n (2 * n))) :
    ∃ {a, b} ⊆ A, a ≠ b ∧ ∃ k : ℕ, a + b = k ^ 2 ∨
    ∃ {a, b} ⊆ Finset.Icc n (2 * n) \ A, a ≠ b ∧ ∃ k : ℕ, a + b = k ^ 2 :=
  let A := Finset.Icc n (2 * n)
  notations A := Finset.Icc n (2 * n)
  notations B := Finset.Icc n (2 * n)
  with A ⊆ B; count_of_subset
  /- Now use existing lemmas to prove this. -/
  simp_rw [←←Finset.count_exists, ←Finset.exists_subset_iff, Finset.exists_subset_iff]
  obtain ⟨C, hC, hCA⟩ | ⟨C, hC, hCA⟩ := Finset.exists_subset_or_subset_of_card_le n
  all_goals simpa
