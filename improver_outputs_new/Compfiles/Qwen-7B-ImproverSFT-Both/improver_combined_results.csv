",,True,-1,"--name=Classical.choose_spec
--context_item_type=theorem
theorem choose_spec {α : Sort u} {p : α → Prop} (h : ∃ x, p x) : p (choose h)  := by
  rw [choose, choose_spec, Classical.choose_spec]

--name=Classical.choose
--context_item_type=def
/--
Given that there exists an element satisfying `p`, returns one such element.

This is a straightforward consequence of, and equivalent to, `Classical.choice`.

See also `choose_spec`, which asserts that the returned value has property `p`.
-/
noncomputable def choose {α : Sort u} {p : α → Prop} (h : ∃ x, p x) : α   := by
  exact (Classical.choose (choose_spec h)).val

