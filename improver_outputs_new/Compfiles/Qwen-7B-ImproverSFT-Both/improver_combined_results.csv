",,True,-1," theorem iterate_one : f^[1] = f  := by induction _ with _ ih ↦ rfl

 theorem iterate_add (m : ℕ) : ∀ n : ℕ, f^[m + n] = f^[m] ∘ f^[n]  := by
  induction m with _ ih ↦ rfl

 theorem iterate_add' (k : ℕ) : f^[k] = f^[(k div 2)] ∘ f^[k mod 2]    := by
  induction k with _ ih ↦ by simp; rw [div_eq_zero, mod_eq_k]; rfl

 theorem iterate_comm : f^[1] ∘ f^[1] = f^[1] ∘ f^[1]   := by rfl

 theorem iterate_comm' : f^[2] ∘ f^[2] = f^[2] ∘ f^[2]  := by rfl

 theorem mul_succ (n m : ℕ) : n * succ m = n * m + n   := by simp

 theorem mul_left_inj (a : G) {b c : G} : b * a = c * a ↔ b = c    := by simp

 theorem sq : ∀ (a : α) : a = 2 * k + 1 ↔ ⟨k,/bit_and⟩  := by
  rintro ⟨k, rfl⟩
  exact ⟨k, (1 bitand k).symm⟩
  rintro (2 * k + 1)
  exact ⟨k, bitand_id bit_emask⟩
