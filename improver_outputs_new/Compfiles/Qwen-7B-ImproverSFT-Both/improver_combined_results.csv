      have h27 : (a:ℤ) - 1 = 0 := pow_eq_zero h26
      have h28 : (a:ℤ) = 1 := Int.sub_eq_zero.mp h27
      exact Int.ofNat_inj.mp h28
    rw [h30] at h23
    exact h23

  simp (config := {decide := true}) only [h9, h11]


