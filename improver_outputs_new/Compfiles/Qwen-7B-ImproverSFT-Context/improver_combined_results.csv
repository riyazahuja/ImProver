@[field_simps]
 theorem two_ne_zero [OfNat α 2] [NeZero (2 : α)] : (2 : α)  ≠ 0  := NeZero.ne (2 : α)

--name=le_of_lt
 theorem le_of_lt (hab : a < b) : a ≤ b  := (lt_iff_le_not_le.1 hab).1

--lemma pow_left_inj₀
 theorem pow_left_inj₀ (ha : 0 ≤ a) (hb : 0 ≤ b) (hn : n ≠ 0) : a ^ n = b ^ n ↔ a = b  := by
