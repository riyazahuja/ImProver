    let friend : ℝ+ → ℝ+ := fun x ↦ Classical.choose (hf x).exists
    have h10 : ∀ x y, x * f y + y * f x ≤ ⟨2, two_pos⟩ ↔
                      y * f x + x * f y ≤ ⟨2, two_pos⟩ := by
