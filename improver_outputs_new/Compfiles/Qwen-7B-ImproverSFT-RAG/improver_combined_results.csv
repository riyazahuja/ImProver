        obtain ⟨cc, hcc⟩ := c
        rw [←Subtype.coe_inj]
        simp
      rw [h21] at h20
      exact h20

    refine ⟨2 / c.val, c.val - 2 / c.val, div_pos two_pos c.prop, ?_⟩
    intro x

