          have h3 := hy2 (friend x) H2
          have h4 : y = (friend (friend x)) := by
            have h5 := Classical.choose_spec (hf (friend x)).exists
            exact (hy2 (friend (friend x)) h5).symm
          rw [h0] at h4
          rw [h4] at h3
