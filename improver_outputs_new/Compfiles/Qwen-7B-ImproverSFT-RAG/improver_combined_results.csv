  · rw [←h1] at ⊢ ⊢; simp [←heq]; linarith [h1.le_a]
  wlog h2 : a ≤ c with H2
  · add simp [h2] at ⊢ ⊢; linarith [h2.le_a, λ h3 =>←h3]
  wlog h3 : b ≤ c with H3
  · add simp [h3] at ⊢ ⊢; linarith [h3.le_b, λ h4 =>←h4]
  all_goals ring_nf at ⊢; linear_combination ha + hb + hc + heq


