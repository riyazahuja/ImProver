    intro P
    suffices h : ∃ a b : ℝ, 0 < a ∧ ∀ x, (f x).val = a * x.val + b by
      rw [solution_set, Set.mem_singleton_iff]
      obtain ⟨a, b, ha, hab⟩ := h
      funext x
      rw [←Subtype.coe_inj]

      suffices h : a = 1 ∧ b = 1 by simp [hab, h]

      have P1 : ∀ x : ℝ+, a^2 * x.val + a * b + b = b * x.val + 2 := by
        intro x
        have P2 := P x 1
