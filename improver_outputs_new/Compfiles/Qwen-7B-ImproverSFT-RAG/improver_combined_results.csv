      have h2 : ⟨2, two_pos⟩ < x * f x + x * f x := by
        obtain ⟨y, _, hy2⟩ := hf x
        by_contra! H2
        have h3 := hy2 x H2
        have h4 : y = friend x := by
          have h5 := Classical.choose_spec (hf x).exists
          exact (hy2 (friend x) h5).symm
        rw [h4] at h3
        exact H h3.symm
      have h6' : 1 < x * f x := by
