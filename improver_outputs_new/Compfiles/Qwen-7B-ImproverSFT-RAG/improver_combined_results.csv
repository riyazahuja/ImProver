        apply_fun (fun x ↦ (x + (1%2))%2) at h10
        rw [←Nat.add_mod, Nat.sub_add_cancel hq_pos] at h10
        norm_num at h10
        have h15 : 2 ∣ q := Nat.modEq_zero_iff_dvd.mp h10.symm
