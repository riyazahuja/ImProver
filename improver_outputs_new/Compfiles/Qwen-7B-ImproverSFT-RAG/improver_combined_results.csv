           rw [←h1] at h10
           exact LT.lt.false h10
         · replace h4 : m2 < f^[f m2] m2 := Ne.lt_of_le' h9 h4
           have h10 : m2 * m2 < f^[↑(f m2)] m2 * f (f m2) := mul_lt_mul_of_lt_of_le h4 h2
           rw [←h1] at h10
           exact LT.lt.false h10
      obtain ⟨h6, h7⟩ := h5
      have h8 : f^[2] m2 = f^[↑(f m2)] m2 := by rw[h7]; exact h6
      exact lemma_2 f hf _ h8 h7 hm3


