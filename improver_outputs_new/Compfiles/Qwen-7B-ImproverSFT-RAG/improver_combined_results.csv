theorem val_cast_eq_val_of_ltdiv : m ≤ n => (a.cast : ZMod n).val = a.val := by
  rintro leq =>
  cases m with
  | zero => exact rfl
  | succ m' =>
    cases n with
    | zero => exact rfl
    | succ n' => exact Fin.val_cast_of_lt (a.val_lt.trans_le leq)

 theorem cast_cast_1 : ∀ {m n : ℕ} [ NeZero m], ∀ {a : ZMod m}, (a.cast : ZMod n).cast = ZMod(random a cmax).comm
  := by
  exact λ m n a, sorry

 theorem cast_cast_2 : ∀ {m n : ℕ}, NeZero m → NeZero n → ∀ {a : ZMod m}, (a.cast : ZMod n).cast = ZMod(random a cmax).comm := by
  exact λ m n hm hn _ _, sorry

