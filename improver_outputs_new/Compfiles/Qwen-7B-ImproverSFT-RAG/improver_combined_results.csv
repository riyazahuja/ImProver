  | nat m =>
    rcases m with _ | _ | m
    · simp
    · simp
    · simp only [Int.natCast_add, Nat.cast_one, Int.even_add_one, not_not, Int.even_coe_nat]
      rw [Int.add_sub_cancel]
      exact preNormEDS_odd_ofNat ..
