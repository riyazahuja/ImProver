  fun _S₁ _S₂ h => SetLike.ext (SetLike.ext_iff.mp h :)
instance (priority := low) module' [Semiring R'] [SMul R' R] [Module R' A] [IsScalarTower R' R A] :
    Module R' S :=
  S.toSubmodule.module'
instance : Module R S :=
  S.module'
