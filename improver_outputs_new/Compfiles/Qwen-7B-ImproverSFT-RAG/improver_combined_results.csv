      simp at this
      rw [hz (f 0), hz 0, hd] at this
      simp at this
      exact this
    intro z
    convert hz z
    rw [hd, this, zero_mul, add_zero]
  · right
    use f 0
    cases' em (f 0 = 0) with hf₀ hf₀
    · have := hf 1 0
      simp at this
      rw [hz (f 1), hz 2, hz 1, hf₀] at this
      simp [hd] at this
      convert hz
    · have := hf 0 0
