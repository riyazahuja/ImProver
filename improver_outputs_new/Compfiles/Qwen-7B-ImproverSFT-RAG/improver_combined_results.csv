    _ ≤ A ! * (A + 1) ^ n' := by gcongr; exact le_sum
    _ ≤ (A + n')! := Nat.factorial_mul_pow_le_factorial
    _ = (∑ i ∈ Finset.range (n' + 1), i)! := by rw [Finset.sum_range_succ]


