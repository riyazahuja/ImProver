--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.Algebra.Category.ModuleCat.Basic
lemma coe_of (X : Type v) [Ring X] [Module R X] : (of R X : Type v) = X :=
  rfl
-- Ensure the roundtrips are reducibly defeq (so tactics like `rw` can see through them).
variable {R} in
@[ext]
structure Hom (M N : ModuleCat.{v} R) where
  private mk ::
  hom : M →ₗ[R] N
instance moduleCategory : Category.{v, max (v+1) u} (ModuleCat.{v} R) where
  Hom M N := Hom M N
  id _ := ⟨LinearMap.id⟩
  comp f g := ⟨g.hom.comp f.hom⟩
instance {M N : ModuleCat.{v} R} : CoeFun (M ⟶ N) (fun _ ↦ M → N) where
  coe f := f.hom
@[simp]
lemma hom_id {M : ModuleCat.{v} R} : (𝟙 M : M ⟶ M).hom = LinearMap.id := rfl

</DOC>
<DOC>

--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.Algebra.Algebra.Subalgebra.Basic
theorem toSubmodule_injective : Function.Injective (toSubmodule : Subalgebra R A → Submodule R A) :=
  fun _S₁ _S₂ h => SetLike.ext (SetLike.ext_iff.mp h :)
instance (priority := low) module' [Semiring R'] [SMul R' R] [Module R' A] [IsScalarTower R' R A] :
    Module R' S :=
  S.toSubmodule.module'
instance : Module R S :=
  S.module'
instance [Semiring R'] [SMul R' R] [Module R' A] [IsScalarTower R' R A] : IsScalarTower R' R S :=
  inferInstanceAs (IsScalarTower R' R (toSubmodule S))

</DOC>
