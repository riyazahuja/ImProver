",,True,-1," theorem usam2018_p1 (a b c : ℝ) :
    a > 0 → b > 0 → c > 0 → a + b + c = 4 * (a * b * c) ^ ((1 : ℝ) / 3) →
    2 * (a * b + b * c + c * a) +
     4 * (min (min (a * a) (b * b)) (c * c)) ≥ a^2 + b^2 + c^2   := by
  intro ha hb hc heq
  wlog h1 : a ≤ b with H1
  cases' le_antisymm h1 (le_of_lt ha) with h2 h3
  · have h0 : min (min (a * a) (b * b)) (c * c) = min (a * a) (min (b * b) (c * c)) := by simp [min_comm]
    rw [h0]
    calc 2 * (a * b + b * c + c * a) - (a^2 + b^2 + c^2) = (b * a - a^2) + (c * b - b^2) + (a * c - c^2) := by ring
    linarith [h2, h3, mul_left_mem_self ha.le hb.le hc.le]
  · have h0 : min (min (a * a) (b * b)) (c * c) = min (b * b) (c * c) := by simp [min_comm, h1, le_antisymm (le_of_lt ha) h2]
    rw [h0]
    calc 2 * (a * b + b * c + c * a) - (a^2 + b^2 + c^2) = (b * a - b^2) + (c * b - c^2) + (a * c + b^2 - c^2 + c * a - a^2) := by ring
    linarith [h3, mul_left_mem_self ha.le hb.le hc.le, mul_left_mem_self ha.le hb.le hc.le]




