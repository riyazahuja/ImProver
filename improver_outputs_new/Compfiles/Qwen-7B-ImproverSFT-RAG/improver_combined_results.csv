      exact lemma0 hf h10 x
    have h1 : ∀ x, friend x = x := fun x ↦ by
      by_contra! H
      have h2 : ⟨2, two_pos⟩ < x * f x + x * f x := by
        obtain ⟨y, _, hy2⟩ := hf x
        by_contra! H2
        have h3 := hy2 x H2
        have h4 : y = friend x := by
