problem usa2022_p4 (p q : ℕ) :
    (p, q) ∈ solution_set ↔
    p.Prime ∧ q.Prime ∧
    ∃ a, a^2 + q = p ∧ ∃ b, b^2 + q = p * q := by
  constructor
  · -- easy direction
    intro hpq
    obtain ⟨rfl, rfl⟩ := hpq
