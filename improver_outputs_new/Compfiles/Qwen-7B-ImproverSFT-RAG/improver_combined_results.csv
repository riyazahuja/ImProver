      have h11 : b + a = b - a + 2 * a := by
        rw [Nat.two_mul, ←add_assoc, add_left_inj]
        exact Nat.eq_add_of_sub_eq (Nat.le_of_lt hba) rfl
      rw [h11, Nat.add_mod]
      simp only [Nat.mul_mod_right, add_zero, Nat.mod_mod]
    rw [h7, ←h8] at h10
