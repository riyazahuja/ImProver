        exact (not_lt_zero' (Nat.succ_lt_succ_iff.mp (Nat.succ_lt_succ_iff.mp h14))).elim

  have h11 : p = 3 := by
    have h20 : b - a = 1 := by rw [h9] at h8; exact h8.symm
