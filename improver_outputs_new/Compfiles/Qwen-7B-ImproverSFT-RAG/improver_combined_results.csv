-1,False,38,"problem imo2018_p2 (n k : ℕ) :
    (n, k) ∈ solution_set ↔
    0 < n ∧ 0 < k ∧
    (k ! : ℤ) = ∏ i ∈ Finset.range n, ((2:ℤ)^n - (2:ℤ)^i) := by
  constructor
  · intro nk
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Prod.mk.injEq] at nk
    obtain ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ := nk <;> decide
