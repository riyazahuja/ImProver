                   _ < x * f (friend x) + friend x * f x := by gcongr
                   _ ≤ ⟨2, two_pos⟩ := h11 _
      exact LT.lt.false this
    have hf' : ∀ x, f x ≤ 1 / x := fun x ↦ by
