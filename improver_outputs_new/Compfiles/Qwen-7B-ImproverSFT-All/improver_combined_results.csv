          change 1 < (friend x * f (friend x)).val
          linarith
        exact div_lt_iff_lt_mul'.mpr h9
      have := calc ⟨2, two_pos⟩ ≤ x / friend x + friend x / x := amgm x (friend x)
                   _ = x * (1 / friend x) + friend x * (1 / x) := by
