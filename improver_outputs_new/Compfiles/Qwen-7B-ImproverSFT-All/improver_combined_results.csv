--src: /home/riyaza/eval_improver/improver/RAG/annotated/Mathlib/Mathlib.Topology.Homotopy.Path
theorem target (F : Homotopy p₀ p₁) (t : I) : F (t, 1) = x₁ :=
  calc F (t, 1) = p₀ 1 := ContinuousMap.HomotopyRel.eq_fst _ _ (.inr rfl)
  _ = x₁ := p₀.target

</DOC>
