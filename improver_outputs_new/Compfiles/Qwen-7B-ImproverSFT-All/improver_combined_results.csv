  | neg h m =>
    simp_rw [show 2 * -(m : ℤ) = -(2 * m) by omega, show -(m : ℤ) - 1 = -(m + 1) by omega,
      show -(m : ℤ) + 2 = -(m - 2) by omega, show -(m : ℤ) - 2 = -(m + 2) by omega,
      show -(m : ℤ) + 1 = -(m - 1) by omega, preNormEDS_neg, h m]
    ring1

