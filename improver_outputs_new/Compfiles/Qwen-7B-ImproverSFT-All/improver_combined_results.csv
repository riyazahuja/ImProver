      suffices H : x * f x ≤ 1 by exact le_div_iff_mul_le'.mpr H
      have h14 : (⟨2, two_pos⟩ : ℝ+) = ⟨2, two_pos⟩ * 1 := self_eq_mul_right.mpr rfl
