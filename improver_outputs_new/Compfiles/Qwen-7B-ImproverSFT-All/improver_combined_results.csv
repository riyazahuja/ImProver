    natDegree (c • f) ≤ n  := by
  exact (natDegree_smul_le c f).trans hf

theorem degree_smul_le_of_le {n : ℕ} {c : R} {f : R[X]} (hf : degree f ≤ n) :
    degree (c • f) ≤ n  := by
  exact (degree_smul_le c f).trans hf

