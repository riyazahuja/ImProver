",,True,-1,"theorem toSubring_zero : toSubring (0 : R[X]) T (by simp [coeffs]) = 0  := by
  ext i; simp

theorem toSubring_one :
    toSubring (1 : R[X]) T
        (Set.Subset.trans coeffs_one <| Finset.singleton_subset_set_iff.2 T.one_mem) =
      1  := by
  ext i; rw [coeff_toSubring', coeff_one, coeff_one, apply_ite Subtype.val, ZeroMemClass.coe_zero, OneMemClass.coe_one]; rfl

theorem toSubring_add :
    toSubring (a + b : R[X]) T (Set.Subset.trans (coeffs a).add_right (coeffs b).add_right (T.add_mem T.add_mem)) =
      toSubring a T ((Set.Subset.trans (coeffs a).add_right ((Set.Subset.trans (coeffs b).add_right T.one_mem)).add_right T.one_mem)) + toSubring b T (T.add_mem) := by
  ext i; simp [subring_add, subring_add, subring_add, subring_add, add_to_subring, sub_to_subring]

theorem toSubring_smul :
    toSubring (a * b : R[X]) T (Set.Subset.trans (coeffs a).add_right (coeffs b).add_right (T.mul_mem T.mul_mem)) =
      toSubring a T ((Set.Subset.trans (coeffs a).add_right ((Set.Subset.trans (coeffs b).add_right T.one_mem)).add_right T.one_mem)) * toSubring b T (T.mul_mem)  := by
  ext i; simp [subring_smul_nonZero, subring_smul_nonZero, subring_smul, subring_smul, add_to_subring, sub_to_subring]

theorem toSubring_neg :
    toSubring (-a : R[X]) T (Set.Subset.trans (coeffs a).add_right ((Set.Subset.trans (coeffs a).add_right T.one_mem)).add_right T.one_mem) =
      - (toSubring a T ((Set.Subset.trans (coeffs a).add_right ((Set.Subset.trans (coeffs a).add_right T.one_mem)).add_right T.one_mem))  := by
  ext i; simp [subring_neg, subring_neg, subring_add, subring_add, add_to_subring, sub_to_subring]
