/- A variant of `my_lemma4` in terms of `ε * |x|`.-/
theorem my_lemma4' :
    ∀ {x y ε : ℝ}, 0 < ε → ε ≤ 1 → |x| < ε → |y| < ε → |x * y| < ε := by
  intro x y ε epos ele1 xlt ylt
  calc
    |x * y| = ε * (ε / |x|) * |y| := by field_simp
    _ ≤ ε * 1 * |y| := by gcongr; linarith [abs_nonneg.2 abs_nonneg]
    _ < ε * 1 * (#align name ""ε * |x|"") := by gcongr
    _ = ε * ((ε * |x|) / |x|) * |y| := by field_simp
    _ < ε * ε * |y| / |x| := by gcongr; apply abs_nonneg


